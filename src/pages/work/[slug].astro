---
import type { CollectionEntry } from "astro:content"
import BaseLayout from "../../layouts/BaseLayout.astro"
import Nav from "../../components/Nav.astro"
import Footer from "../../components/Footer.astro"
import { renderChapter, seo, site, ui, workChapters } from "../../lib/content"

export async function getStaticPaths() {
  const chapters = await workChapters()
  return chapters.map((chapter) => ({
    params: { slug: chapter.id },
    props: { chapter },
  }))
}

export interface Props {
  chapter: CollectionEntry<"work">
}

const { chapter } = Astro.props
const work = chapter.data
const { Content } = await renderChapter(chapter)

const channels = await site()
const labels = (await ui()).workPage
const cardLabels = (await ui()).workCard
const specLabels = (await ui()).workSpec
const meta = await seo()

/**
 * Breadcrumb graph. Gives the chapter a declared relationship to the home page
 * instead of reading as an orphan URL. Names come from content (`siteName` and
 * the chapter title), so no new strings are introduced. JSON-LD in <body> is
 * supported by search engines and renders nothing.
 */
const jsonLdBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": meta.siteName,
      "item": new URL("/", meta.siteUrl).href
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": work.title,
      "item": new URL(Astro.url.pathname, meta.siteUrl).href
    }
  ]
}

const hasProjects = work.projects.length > 0
const hasWriteUp = Boolean(chapter.body?.trim())
const pageTitle = meta.pages.work.titleTemplate.replace("{title}", work.title)
---

<BaseLayout title={pageTitle} description={work.description}>
  <Nav />

  <div class="page">
    <div class="page-inner rail">
      <a href="/#work" class="back-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M10 4l-4 4 4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        {labels.back}
      </a>

      <header class="page-head">
        <p class="page-arena">{work.arena}</p>
        <h1 class="page-title">{work.title}</h1>
        <p class="page-lede">{work.lede}</p>
      </header>

      <div class="page-body">
        <div class="page-main">
          <section class="block">
            <h2 class="block-title">{cardLabels.held}</h2>
            <ul class="block-list">
              {work.responsibilities.map((item) => <li>{item}</li>)}
            </ul>
          </section>

          <section class="block">
            <h2 class="block-title">{cardLabels.taught}</h2>
            <p class="block-text">{work.learned}</p>
          </section>

          {
            hasProjects && (
              <section class="block">
                <h2 class="block-title">{labels.projects}</h2>
                <div class="projects">
                  {work.projects.map((project) => (
                    <article class="project">
                      <h3 class="project-name">{project.name}</h3>
                      <p class="project-summary">{project.summary}</p>
                      <p class="project-outcome">{project.outcome}</p>
                    </article>
                  ))}
                </div>
              </section>
            )
          }

          {
            /* Honest holding state. Carries real value: the facts are all
               true and already on the page, instead of a dashed box. */
            hasWriteUp ? (
              <section class="block">
                <h2 class="block-title">{labels.writeUpTitle}</h2>
                <div class="block-text">
                  <Content />
                </div>
              </section>
            ) : (
              <section class="block holding">
                <h2 class="block-title">{labels.holding.title}</h2>
                <p class="block-text">{labels.holding.body1}</p>
                <p class="block-text">{labels.holding.body2}</p>
                <a
                  href={channels.bookingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="holding-cta"
                >
                  {labels.holding.cta}
                  <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path
                      d="M4 10h11M11 5l5 5-5 5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </section>
            )
          }
        </div>

        <aside class="page-side">
          <dl
            class="spec"
            data-spec-placeholder={work.specPlaceholder ? "true" : undefined}
          >
            <div class="spec-row spec-row--head">
              <dt>{specLabels.client}</dt>
              <dd>{work.client}</dd>
            </div>
            <div class="spec-row spec-row--head">
              <dt>{specLabels.years}</dt>
              <dd class="tabular">{work.years}</dd>
            </div>
            {
              work.spec.map((row) => (
                <div class="spec-row">
                  <dt>{row.label}</dt>
                  <dd class="tabular">{row.value}</dd>
                </div>
              ))
            }
          </dl>

          <div class="side-roles">
            {work.roles.map((role) => <span class="role-tag">{role}</span>)}
          </div>
        </aside>
      </div>
    </div>
  </div>

  <Footer />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLdBreadcrumb)}
  />
</BaseLayout>

<style>
  .page {
    padding: calc(var(--nav-height) + 64px) 24px 120px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: var(--size-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-secondary);
    transition: color var(--duration-fast) var(--ease);
  }

  .back-link:hover {
    color: var(--accent);
  }

  .page-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 24px 0 64px;
  }

  .page-arena {
    font-size: var(--size-sm);
    color: var(--text-muted);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: var(--size-display);
    font-weight: var(--weight-black);
    font-stretch: 110%;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    text-wrap: balance;
  }

  .page-lede {
    font-size: var(--size-lede);
    line-height: var(--leading-snug);
    color: var(--text-secondary);
    max-width: 44ch;
  }

  .page-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 72px;
    align-items: start;
  }

  .page-main {
    display: flex;
    flex-direction: column;
    gap: 48px;
    min-width: 0;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .block-title {
    font-size: var(--size-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-muted);
  }

  .block-text {
    font-size: var(--size-base);
    line-height: var(--leading-body);
    color: var(--text-secondary);
    max-width: var(--measure);
  }

  .block-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .block-list li {
    position: relative;
    padding-left: 20px;
    font-size: var(--size-base);
    line-height: var(--leading-snug);
    color: var(--text-secondary);
    max-width: var(--measure);
  }

  .block-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 1px;
    background: var(--accent);
  }

  .projects {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .project-name {
    font-size: var(--size-md);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    margin-bottom: 6px;
  }

  .project-summary,
  .project-outcome {
    font-size: var(--size-base);
    line-height: var(--leading-body);
    color: var(--text-secondary);
    max-width: var(--measure);
  }

  .project-outcome {
    color: var(--accent);
  }

  .holding {
    padding: 28px;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-surface) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--border-color) 12%, transparent);
    align-items: flex-start;
  }

  .holding-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    padding: 14px 22px;
    min-height: 44px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--bg-primary);
    font-size: var(--size-sm);
    font-weight: var(--weight-semibold);
    transition: transform var(--duration-normal) var(--ease),
      box-shadow var(--duration-normal) var(--ease);
  }

  .holding-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px -14px color-mix(in srgb, var(--accent) 65%, transparent);
  }

  /* --- Side spec panel ---------------------------------------------------- */

  .page-side {
    position: sticky;
    top: calc(var(--nav-height) + 32px);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .spec {
    display: flex;
    flex-direction: column;
    border-top: 1px solid color-mix(in srgb, var(--border-color) 22%, transparent);
  }

  .spec-row {
    display: grid;
    grid-template-columns: minmax(80px, 0.8fr) 1.2fr;
    gap: 12px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--border-color) 12%, transparent);
  }

  .spec-row dt {
    font-size: var(--size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: color-mix(in srgb, var(--text-secondary) 72%, var(--bg-primary));
  }

  .spec-row dd {
    font-size: var(--size-sm);
    color: var(--text-primary);
    text-align: right;
  }

  .spec-row--head dd {
    color: var(--accent);
    font-weight: var(--weight-medium);
  }

  .side-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .role-tag {
    font-size: var(--size-xs);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    padding: 5px 10px;
    border-radius: var(--radius-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .holding-cta:hover {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .page-body {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .page-side {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .spec-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .spec-row dd {
      text-align: left;
    }
  }
</style>
