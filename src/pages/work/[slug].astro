---
import BaseLayout from "../../layouts/BaseLayout.astro"

export async function getStaticPaths() {
  const { works } = await import("../../data/work")
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }))
}

export interface Props {
  work: {
    slug: string
    title: string
    description: string
  }
}

const { work } = Astro.props
---

<BaseLayout title={`${work.title} | Salvatore Cirone`} description={work.description}>
  <div class="page">
    <a href="/" class="back-link">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
        <path d="M10 4l-4 4 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      Back
    </a>
    <h1>{work.title}</h1>
    <p>{work.description}</p>
    <div class="page-placeholder">
      <span>Project detail coming soon</span>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 800px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 40px;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  .page :global(h1) {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .page p {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 60px;
    max-width: 600px;
  }

  .page-placeholder {
    border: 2px dashed var(--border-color);
    border-radius: 8px;
    padding: 80px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }
</style>
