---
import BaseLayout from "../layouts/BaseLayout.astro"
import Nav from "../components/Nav.astro"
import Hero from "../components/Hero.astro"
import Services from "../components/Services.astro"
import WorkCarousel from "../components/WorkCarousel.astro"
import Tinyverse from "../components/Tinyverse.astro"
import Contact from "../components/Contact.astro"
import Footer from "../components/Footer.astro"
import { seo } from "../lib/content"

const home = (await seo()).pages.home
---

<BaseLayout title={home.title} description={home.description} pageType="profile">
  <Nav />
  <main>
    <Hero />
    <Services />
    <WorkCarousel />
    <Tinyverse />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
