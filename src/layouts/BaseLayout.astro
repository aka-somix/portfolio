---
import { design } from "../design.config"
import LoadingScreen from "../components/LoadingScreen.astro"

export interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const { palette, font, type, layout, animation } = design

const cssVars = `
  --bg-primary: ${palette.bg.primary};
  --bg-surface: ${palette.bg.surface};
  --bg-accent: ${palette.bg.accent};
  --text-primary: ${palette.text.primary};
  --text-secondary: ${palette.text.secondary};
  --text-muted: ${palette.text.muted};
  --border-color: ${palette.border.default};
  --border-light: ${palette.border.light};
  --accent: ${palette.accent};
  --font-display: ${font.display};
  --font-sans: ${font.sans};
  --font-mono: ${font.mono};
  --size-min: ${type.size.min};
  --size-xs: ${type.size.xs};
  --size-sm: ${type.size.sm};
  --size-base: ${type.size.base};
  --size-md: ${type.size.md};
  --size-lede: ${type.size.lede};
  --size-xl: ${type.size.xl};
  --size-2xl: ${type.size["2xl"]};
  --size-display: ${type.size.display};
  --size-section: ${type.size.section};
  --leading-tight: ${type.leading.tight};
  --leading-snug: ${type.leading.snug};
  --leading-body: ${type.leading.body};
  --tracking-display: ${type.tracking.display};
  --tracking-tight: ${type.tracking.tight};
  --tracking-label: ${type.tracking.label};
  --weight-regular: ${type.weight.regular};
  --weight-medium: ${type.weight.medium};
  --weight-semibold: ${type.weight.semibold};
  --weight-bold: ${type.weight.bold};
  --weight-black: ${type.weight.black};
  --measure: ${type.measure};
  --nav-height: ${layout.navHeight};
  --max-width: ${layout.maxWidth};
  --radius: ${layout.borderRadius};
  --radius-sm: ${layout.borderRadiusSm};
  --ease: ${animation.ease};
  --duration-fast: ${animation.durationFast};
  --duration-normal: ${animation.durationNormal};
  --duration-slow: ${animation.durationSlow};
`

const siteUrl = "https://about.salvatorecirone.dev"
const ogImage = "/images/og/v1.png"
const siteName = "Salvatore Cirone"

const jsonLdPerson = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Salvatore Cirone",
  "givenName": "Salvatore",
  "familyName": "Cirone",
  "jobTitle": [
    "Cloud Solutions Architect",
    "Senior Backend Engineer",
    "AI Engineer"
  ],
  "description": "Tech nomad turning complex cloud and AI challenges into elegant realities.",
  "url": siteUrl,
  "sameAs": [
    "https://www.linkedin.com/in/salvatore-cirone-it/",
    "https://github.com/aka-somix"
  ],
  "knowsAbout": ["AWS", "Cloud Architecture", "AI/ML", "Node.js", "Python", "Backend Engineering"],
  "image": `${siteUrl}${ogImage}`
}

const jsonLdWebsite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": siteUrl
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteUrl).href} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebsite)} />

    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <style set:html={`:root {${cssVars}}`} is:global />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <LoadingScreen />
    <div id="main-content">
      <slot />
    </div>

    <script>
      import { gsap } from "gsap"
      import { ScrollTrigger } from "gsap/ScrollTrigger"

      gsap.registerPlugin(ScrollTrigger)

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

      if (!reduceMotion) {
        const heroBg = document.querySelector("[data-animate='hero-bg']")
        if (heroBg) {
          gsap.from(heroBg, { opacity: 0, duration: 1, ease: "power2.out" })
        }

        const heroTexts = document.querySelectorAll("[data-animate='hero-text']")
        if (heroTexts.length) {
          gsap.from(heroTexts, {
            y: 30,
            opacity: 0,
            duration: 0.8,
            stagger: 0.12,
            ease: "power3.out",
          })
        }

        const sections = document.querySelectorAll("[data-animate='section']")
        sections.forEach((section) => {
          ScrollTrigger.create({
            trigger: section,
            start: "top 85%",
            onEnter: () => {
              gsap.from(section.children, {
                y: 30,
                opacity: 0,
                duration: 0.6,
                stagger: 0.1,
                ease: "power2.out",
              })
            },
          })
        })

        // Services header stagger
        const servicesHeaderEls = document.querySelectorAll("[data-services-header]")
        if (servicesHeaderEls.length) {
          ScrollTrigger.create({
            trigger: document.querySelector("[data-services-section]"),
            start: "top 85%",
            onEnter: () => {
              gsap.from(servicesHeaderEls, {
                y: 30,
                opacity: 0,
                duration: 0.6,
                stagger: 0.1,
                ease: "power2.out",
              })
            },
          })
        }
      }

      // The services deck now owns its own drag/flip logic in Services.astro,
      // where the geometry it depends on actually lives.

      const loaderRects = gsap.utils.toArray("[data-loader-idx]").sort(
        (a, b) => Number(a.dataset.loaderIdx) - Number(b.dataset.loaderIdx)
      )
      if (loaderRects.length) {
        gsap.set(loaderRects, { opacity: 0 })
        const tl = gsap.timeline({ repeat: -1 })
        tl.to(loaderRects, {
          opacity: 1,
          duration: 0.4,
          stagger: 0.12,
          ease: "power2.inOut",
        })
          .to(loaderRects, {
            opacity: 0,
            duration: 0.4,
            stagger: 0.12,
            ease: "power2.inOut",
          })
      }

      const loadingScreen = document.getElementById("loading-screen")
      if (loadingScreen) {
        window.addEventListener("load", () => {
          gsap.to(loadingScreen, {
            opacity: 0,
            duration: 0.6,
            ease: "power2.inOut",
            onComplete: () => {
              loadingScreen.style.display = "none"
            },
          })
        })
      }
    </script>
  </body>
</html>

<style is:global>
  /* --- Self-hosted variable faces. No third-party font request. ------------ */

  @font-face {
    font-family: "Archivo";
    font-style: normal;
    font-weight: 100 900;
    font-stretch: 62% 125%;
    font-display: swap;
    src: url("/fonts/archivo-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F,
      U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
  }

  @font-face {
    font-family: "Archivo";
    font-style: normal;
    font-weight: 100 900;
    font-stretch: 62% 125%;
    font-display: swap;
    src: url("/fonts/archivo-latin-ext.woff2") format("woff2");
    unicode-range: U+0100-02BA, U+1E00-1E9F, U+2020, U+20A0-20AB, U+2C60-2C7F,
      U+A720-A7FF;
  }

  @font-face {
    font-family: "Inter";
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url("/fonts/inter-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F,
      U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
  }

  @font-face {
    font-family: "Inter";
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url("/fonts/inter-latin-ext.woff2") format("woff2");
    unicode-range: U+0100-02BA, U+1E00-1E9F, U+2020, U+20A0-20AB, U+2C60-2C7F,
      U+A720-A7FF;
  }

  @font-face {
    font-family: "JetBrains Mono";
    font-style: normal;
    font-weight: 100 800;
    font-display: swap;
    src: url("/fonts/jetbrainsmono-latin.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F,
      U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215;
  }

  @font-face {
    font-family: "JetBrains Mono";
    font-style: normal;
    font-weight: 100 800;
    font-display: swap;
    src: url("/fonts/jetbrainsmono-latin-ext.woff2") format("woff2");
    unicode-range: U+0100-02BA, U+1E00-1E9F, U+2020, U+20A0-20AB, U+2C60-2C7F,
      U+A720-A7FF;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--bg-accent) 70%, white)
      var(--bg-primary);
  }

  /* Smooth scrolling is motion too. */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  /* WebKit does not read scrollbar-color; theme it explicitly. */
  ::-webkit-scrollbar {
    width: 12px;
    height: 12px;
  }

  ::-webkit-scrollbar-track {
    background: var(--bg-primary);
  }

  ::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--bg-accent) 70%, white);
    border: 3px solid var(--bg-primary);
    border-radius: 999px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
  }

  body {
    font-family: var(--font-sans);
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: var(--size-base);
    line-height: var(--leading-body);
    caret-color: var(--accent);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: block;
  }

  /* --- Focus. Authored once, on the dark palette, for every control. ------- */

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* Only suppress the ring for pointer users, never for keyboard. */
  :focus:not(:focus-visible) {
    outline: none;
  }

  /* --- Shared section primitives -----------------------------------------
   * These were duplicated verbatim in Services.astro and WorkCarousel.astro
   * with divergent margins. One definition, one rail.
   * -----------------------------------------------------------------------*/

  .rail {
    max-width: var(--max-width);
    margin-inline: auto;
  }

  .section-label {
    font-family: var(--font-display);
    font-size: var(--size-section);
    font-weight: var(--weight-black);
    font-stretch: 112%;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    color: var(--text-primary);
    text-wrap: balance;
  }

  /* Measure only. Alignment is the .rail wrapper's job — putting both on one
     element makes `margin-inline: auto` centre the 66ch block instead of
     aligning it to the rail. */
  .section-description {
    font-size: var(--size-md);
    line-height: var(--leading-snug);
    color: var(--text-secondary);
    max-width: var(--measure);
    margin-inline: 0;
  }

  /* Mono earns its place on figures, not on costume labels. */
  .tabular {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum" 1;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: 8px;
    z-index: 1000;
    padding: 8px 16px;
    background: var(--accent);
    color: var(--bg-primary);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 0;
  }

  /* Sections are separated by space and a hairline, not by a 5px white rule
     that acted as a hard cut between every section. */
  section[id] {
    scroll-margin-top: var(--nav-height);
    border-bottom: 1px solid color-mix(in srgb, var(--border-color) 12%, transparent);
  }

  ::selection {
    background: var(--accent);
    color: var(--bg-primary);
  }
</style>
