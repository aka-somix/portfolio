---
import { design } from "../design.config"
import LoadingScreen from "../components/LoadingScreen.astro"

export interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const { palette, font, layout, animation } = design

const cssVars = `
  --bg-primary: ${palette.bg.primary};
  --bg-surface: ${palette.bg.surface};
  --bg-accent: ${palette.bg.accent};
  --text-primary: ${palette.text.primary};
  --text-secondary: ${palette.text.secondary};
  --text-muted: ${palette.text.muted};
  --border-color: ${palette.border.default};
  --border-light: ${palette.border.light};
  --accent: ${palette.accent};
  --font-sans: ${font.sans};
  --font-mono: ${font.mono};
  --nav-height: ${layout.navHeight};
  --max-width: ${layout.maxWidth};
  --radius: ${layout.borderRadius};
  --radius-sm: ${layout.borderRadiusSm};
  --ease: ${animation.ease};
  --duration-fast: ${animation.durationFast};
  --duration-normal: ${animation.durationNormal};
  --duration-slow: ${animation.durationSlow};
`

const siteUrl = "https://about.salvatorecirone.dev"
const ogImage = "/images/og/v1.png"
const siteName = "Salvatore Cirone"

const jsonLdPerson = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Salvatore Cirone",
  "givenName": "Salvatore",
  "familyName": "Cirone",
  "jobTitle": "Senior Backend Engineer",
  "description": "Tech nomad turning complex cloud and AI challenges into elegant realities.",
  "url": siteUrl,
  "sameAs": [
    "https://www.linkedin.com/in/salvatore-cirone-it/",
    "https://github.com/aka-somix"
  ],
  "knowsAbout": ["AWS", "Cloud Architecture", "AI/ML", "Node.js", "Python", "Backend Engineering"],
  "image": `${siteUrl}${ogImage}`
}

const jsonLdWebsite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": siteUrl
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteUrl).href} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteUrl).href} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdWebsite)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={font.googleFontsUrl} rel="stylesheet" />
    <style set:html={`:root {${cssVars}}`} is:global />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <LoadingScreen />
    <div id="main-content">
      <slot />
    </div>

    <script>
      import { gsap } from "gsap"
      import { ScrollTrigger } from "gsap/ScrollTrigger"

      gsap.registerPlugin(ScrollTrigger)

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

      if (!reduceMotion) {
        const heroBg = document.querySelector("[data-animate='hero-bg']")
        if (heroBg) {
          gsap.from(heroBg, { opacity: 0, duration: 1, ease: "power2.out" })
        }

        const heroTexts = document.querySelectorAll("[data-animate='hero-text']")
        if (heroTexts.length) {
          gsap.from(heroTexts, {
            y: 30,
            opacity: 0,
            duration: 0.8,
            stagger: 0.12,
            ease: "power3.out",
          })
        }

        const sections = document.querySelectorAll("[data-animate='section']")
        sections.forEach((section) => {
          ScrollTrigger.create({
            trigger: section,
            start: "top 85%",
            onEnter: () => {
              gsap.from(section.children, {
                y: 30,
                opacity: 0,
                duration: 0.6,
                stagger: 0.1,
                ease: "power2.out",
              })
            },
          })
        })

        // Services header stagger
        const servicesHeaderEls = document.querySelectorAll("[data-services-header]")
        if (servicesHeaderEls.length) {
          ScrollTrigger.create({
            trigger: document.querySelector("[data-services-section]"),
            start: "top 85%",
            onEnter: () => {
              gsap.from(servicesHeaderEls, {
                y: 30,
                opacity: 0,
                duration: 0.6,
                stagger: 0.1,
                ease: "power2.out",
              })
            },
          })
        }
      }

      // Services drag deck animation
      const servicesTrack = document.querySelector("[data-services-track]")
      const servicesWrapper = servicesTrack?.parentElement
      const deckCards = servicesTrack
        ? [...servicesTrack.querySelectorAll(".service-card")]
        : []
      const DN = deckCards.length

      if (servicesTrack && servicesWrapper && DN) {
        const SLOT = 384
        // Push stack so card is half off the left edge of the viewport
        const STACK_LEFT = -(servicesWrapper.getBoundingClientRect().left + 180)
        const STACK_OFF_X = 6
        const STACK_OFF_Y = 3
        const STACK_ROT = -0.5
        const clamp = gsap.utils.clamp
        const lerp = gsap.utils.interpolate
        let currentProgress = 0
        const baseRots = deckCards.map((_, i) => (i - (DN - 1) / 2) * 1.5)

        function layout(p: number) {
          const prog = clamp(0, DN - 1, p)
          currentProgress = prog
          deckCards.forEach((card, i) => {
            const depth = Math.max(0, prog - i)
            const baseRot = baseRots[i]
            if (depth >= 1) {
              gsap.set(card, {
                x: STACK_LEFT + i * STACK_OFF_X,
                y: i * STACK_OFF_Y,
                rotation: baseRot + i * STACK_ROT,
                zIndex: i,
              })
            } else if (depth <= 0) {
              gsap.set(card, {
                x: (i - prog) * SLOT,
                y: 0,
                rotation: baseRot,
                zIndex: DN + 1,
              })
            } else {
              gsap.set(card, {
                x: lerp((i - prog) * SLOT, STACK_LEFT + i * STACK_OFF_X, depth),
                y: lerp(0, i * STACK_OFF_Y, depth),
                rotation: lerp(baseRot, baseRot + i * STACK_ROT, depth),
                zIndex: DN + 1,
              })
            }
          })
        }

        layout(0)

        const overlay = servicesWrapper.appendChild(document.createElement("div"))
        Object.assign(overlay.style, {
          position: "absolute",
          inset: "0",
          zIndex: "10",
          cursor: "grab",
          touchAction: "none",
        })

        let dragStartX = 0
        let dragStartProgress = 0
        let isDragging = false
        let velX = 0
        let lastX = 0
        let lastT = 0
        let snapTween: gsap.core.Tween | null = null

        overlay.addEventListener("pointerdown", (e: PointerEvent) => {
          snapTween?.kill()
          isDragging = true
          dragStartX = e.clientX
          dragStartProgress = currentProgress
          velX = 0
          lastX = e.clientX
          lastT = performance.now()
          overlay.setPointerCapture(e.pointerId)
          overlay.style.cursor = "grabbing"
        })

        overlay.addEventListener("pointermove", (e: PointerEvent) => {
          if (!isDragging) return
          const now = performance.now()
          const dt = now - lastT
          if (dt > 0) velX = (e.clientX - lastX) / dt
          lastX = e.clientX
          lastT = now
          layout(clamp(0, DN - 1, dragStartProgress - (e.clientX - dragStartX) / SLOT))
        })

        const endDrag = () => {
          if (!isDragging) return
          isDragging = false
          overlay.style.cursor = "grab"
          const projected = clamp(0, DN - 1, currentProgress - (velX * 120) / SLOT)
          snapTo(Math.round(projected))
        }

        overlay.addEventListener("pointerup", endDrag)
        overlay.addEventListener("pointercancel", endDrag)

        function snapTo(targetP: number) {
          const proxy = { p: currentProgress }
          snapTween = gsap.to(proxy, {
            p: targetP,
            duration: 0.4,
            ease: "power2.out",
            onUpdate: () => layout(proxy.p),
          })
        }
      }

      const loaderRects = gsap.utils.toArray("[data-loader-idx]").sort(
        (a, b) => Number(a.dataset.loaderIdx) - Number(b.dataset.loaderIdx)
      )
      if (loaderRects.length) {
        gsap.set(loaderRects, { opacity: 0 })
        const tl = gsap.timeline({ repeat: -1 })
        tl.to(loaderRects, {
          opacity: 1,
          duration: 0.4,
          stagger: 0.12,
          ease: "power2.inOut",
        })
          .to(loaderRects, {
            opacity: 0,
            duration: 0.4,
            stagger: 0.12,
            ease: "power2.inOut",
          })
      }

      const loadingScreen = document.getElementById("loading-screen")
      if (loadingScreen) {
        window.addEventListener("load", () => {
          gsap.to(loadingScreen, {
            opacity: 0,
            duration: 0.6,
            ease: "power2.inOut",
            onComplete: () => {
              loadingScreen.style.display = "none"
            },
          })
        })
      }
    </script>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: var(--border-color) var(--bg-primary);
  }

  body {
    font-family: var(--font-sans);
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: block;
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: 8px;
    z-index: 1000;
    padding: 8px 16px;
    background: var(--accent);
    color: var(--bg-primary);
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 0;
  }

  section[id] {
    scroll-margin-top: var(--nav-height);
    border-bottom: 5px solid var(--border-color);
  }

  ::selection {
    background: var(--text-primary);
    color: var(--bg-primary);
  }
</style>
