---
import { design } from "../design.config"

export interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
const { palette, font, layout, animation } = design

const cssVars = `
  --bg-primary: ${palette.bg.primary};
  --bg-surface: ${palette.bg.surface};
  --bg-accent: ${palette.bg.accent};
  --text-primary: ${palette.text.primary};
  --text-secondary: ${palette.text.secondary};
  --text-muted: ${palette.text.muted};
  --border-color: ${palette.border.default};
  --border-light: ${palette.border.light};
  --accent: ${palette.accent};
  --font-sans: ${font.sans};
  --font-mono: ${font.mono};
  --nav-height: ${layout.navHeight};
  --max-width: ${layout.maxWidth};
  --radius: ${layout.borderRadius};
  --radius-sm: ${layout.borderRadiusSm};
  --ease: ${animation.ease};
  --duration-fast: ${animation.durationFast};
  --duration-normal: ${animation.durationNormal};
  --duration-slow: ${animation.durationSlow};
`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description ?? "Portfolio"} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={font.googleFontsUrl} rel="stylesheet" />
  </head>
  <body>
    <slot />

    <script>
      import { gsap } from "gsap"
      import { ScrollTrigger } from "gsap/ScrollTrigger"
      import { Draggable } from "gsap/Draggable"

      gsap.registerPlugin(ScrollTrigger, Draggable)

      document.addEventListener("astro:page-load", () => {
        const heroBg = document.querySelector("[data-animate='hero-bg']")
        if (heroBg) {
          gsap.from(heroBg, { opacity: 0, duration: 1, ease: "power2.out" })
        }

        const heroTexts = document.querySelectorAll("[data-animate='hero-text']")
        if (heroTexts.length) {
          gsap.from(heroTexts, {
            y: 30,
            opacity: 0,
            duration: 0.8,
            stagger: 0.12,
            ease: "power3.out",
          })
        }

        const sections = document.querySelectorAll("[data-animate='section']")
        sections.forEach((section) => {
          ScrollTrigger.create({
            trigger: section,
            start: "top 85%",
            onEnter: () => {
              gsap.to(section.children, {
                y: 0,
                opacity: 1,
                duration: 0.6,
                stagger: 0.1,
                ease: "power2.out",
              })
            },
          })
        })

        const navLinks = document.querySelectorAll("[data-animate='nav-link']")
        navLinks.forEach((link) => {
          link.addEventListener("mouseenter", () => {
            const text = link.querySelector("[data-nav-text]")
            if (text) {
              gsap.to(text, { y: -4, duration: 0.2, ease: "power2.out" })
            }
          })
          link.addEventListener("mouseleave", () => {
            const text = link.querySelector("[data-nav-text]")
            if (text) {
              gsap.to(text, { y: 0, duration: 0.2, ease: "power2.out" })
            }
          })
        })

        const cta = document.querySelector("[data-animate='cta']")
        if (cta) {
          cta.addEventListener("mouseenter", () => {
            gsap.to(cta.querySelector("[data-cta-label]"), {
              y: -24,
              duration: 0.25,
              ease: "power2.out",
            })
            gsap.to(cta.querySelector("[data-cta-alt]"), {
              y: 0,
              duration: 0.25,
              ease: "power2.out",
            })
          })
          cta.addEventListener("mouseleave", () => {
            gsap.to(cta.querySelector("[data-cta-label]"), {
              y: 0,
              duration: 0.25,
              ease: "power2.out",
            })
            gsap.to(cta.querySelector("[data-cta-alt]"), {
              y: 24,
              duration: 0.25,
              ease: "power2.out",
            })
          })
        }

        const draggableEl = document.querySelector("[data-draggable]")
        if (draggableEl) {
          const wrapper = draggableEl.parentElement
          if (!wrapper) return

          const cards = [...draggableEl.querySelectorAll(".service-card")]
          const N = cards.length
          if (!N) return

          const SLOT = 324
          const STACK_LEFT = 48
          const STACK_OFF_X = 6
          const STACK_OFF_Y = 3
          const STACK_ROT = -0.5
          const clamp = gsap.utils.clamp
          const lerp = gsap.utils.interpolate
          let currentProgress = 0

          function layout(p: number) {
            const prog = clamp(0, N - 1, p)
            currentProgress = prog
            cards.forEach((card, i) => {
              const depth = Math.max(0, prog - i)
              if (depth >= 1) {
                gsap.set(card, {
                  x: STACK_LEFT + i * STACK_OFF_X,
                  y: i * STACK_OFF_Y,
                  rotation: i * STACK_ROT,
                  zIndex: i,
                })
              } else if (depth <= 0) {
                gsap.set(card, {
                  x: (i - prog) * SLOT,
                  y: 0,
                  rotation: 0,
                  zIndex: N + 1,
                })
              } else {
                gsap.set(card, {
                  x: lerp((i - prog) * SLOT, STACK_LEFT + i * STACK_OFF_X, depth),
                  y: lerp(0, i * STACK_OFF_Y, depth),
                  rotation: lerp(0, i * STACK_ROT, depth),
                  zIndex: N + 1,
                })
              }
            })
          }

          layout(0)

          const overlay = wrapper.appendChild(document.createElement("div"))
          Object.assign(overlay.style, {
            position: "absolute",
            inset: "0",
            zIndex: "10",
            cursor: "grab",
            touchAction: "none",
          })

          Draggable.create(overlay, {
            type: "x",
            inertia: true,
            bounds: { minX: -(N - 1) * SLOT, maxX: 0 },
            onDrag: function () { layout(-this.x / SLOT) },
            onThrowUpdate: function () { layout(-this.x / SLOT) },
            onThrowComplete: function () { snapTo(Math.round(clamp(0, N - 1, -this.x / SLOT))) },
            onRelease: function () {
              if (!this.isThrowing) snapTo(Math.round(clamp(0, N - 1, -this.x / SLOT)))
            },
          })

          function snapTo(targetP: number) {
            if (Math.abs(currentProgress - targetP) < 0.01) return
            const proxy = { p: currentProgress }
            gsap.to(proxy, {
              p: targetP,
              duration: 0.35,
              ease: "power2.out",
              onUpdate: () => layout(proxy.p),
            })
          }
        }
      })
    </script>
  </body>
</html>

<style set:html={`:root {${cssVars}}`} is:global />
<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: var(--border-color) var(--bg-primary);
  }

  body {
    font-family: var(--font-sans);
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: block;
  }

  section[id] {
    scroll-margin-top: var(--nav-height);
    border-bottom: 5px solid var(--border-color);
  }

  ::selection {
    background: var(--text-primary);
    color: var(--bg-primary);
  }
</style>
