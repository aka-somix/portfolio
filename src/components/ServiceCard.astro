---
export interface Props {
  image: string
  title: string
  description: string
  imageAlt: string
}

const { image, title, description, imageAlt } = Astro.props

const bits = Array.from({ length: 32 }, () => Math.random() > 0.5)
---

<div class="service-card">
  <div class="card-top-row">
    <img class="card-image" src={image} alt={imageAlt} loading="lazy" />
    <div class="card-barcode">
      {bits.map((bit) => (
        <span class:list={{ bar: true, "bar-1": bit }} />
      ))}
    </div>
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="card-description">{description}</p>
</div>

<style>
  .service-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 360px;
    height: 200px;
    background: linear-gradient(145deg, var(--bg-surface), color-mix(in srgb, var(--bg-surface) 90%, #fff));
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 18px 20px 16px;
    display: flex;
    flex-direction: column;
    user-select: none;
    transition:
      border-color var(--duration-fast),
      box-shadow var(--duration-fast);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }

  .service-card:active {
    cursor: grabbing;
  }

  .service-card:hover {
    border-color: var(--border-light);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
  }

  .card-top-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .card-image {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 8px 0 0;
    line-height: 1.3;
  }

  .card-barcode {
    display: flex;
    align-items: flex-end;
    gap: 1px;
    height: 18px;
    flex-shrink: 0;
    padding-top: 2px;
  }

  .bar {
    width: 1px;
    background: currentColor;
    color: var(--text-muted);
    opacity: 0.1;
    height: 100%;
    border-radius: 0;
  }

  .bar-1 {
    width: 2px;
    opacity: 0.85;
    height: 100%;
  }

  .card-description {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin: 0;
    margin-top: auto;
    padding-bottom: 2px;
  }
</style>
