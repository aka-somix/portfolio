---
import { site } from "../data/site"

/**
 * The headline is the claim, at display scale. It states the combination —
 * architecture, AI, location independence — which is the thing PRODUCT.md says
 * must never flatten to "senior backend engineer".
 *
 * Three explicit lines because the sentence is three sentences, and because the
 * width-axis motion below animates them in sequence.
 */
const headline = [
  "Architecture that holds.",
  "AI that ships.",
  "From wherever I am.",
]
---

<section class="hero" id="hero">
  <div class="hero-portrait" data-animate="hero-bg">
    <img
      src="/images/Hero.png"
      alt="Illustrated low-poly portrait of Salvatore Cirone"
      width="1024"
      height="1024"
      fetchpriority="high"
    />
  </div>

  <div class="hero-inner rail">
    <div class="hero-type">
      <h1 class="hero-headline">
        {
          headline.map((line) => (
            <span class="hl-line" data-hl-line>
              {line}
            </span>
          ))
        }
      </h1>

      <p class="hero-lede" data-animate="hero-text">
        Ciao! I'm <strong>Salvatore</strong> — I turn complex cloud and AI
        challenges into elegant realities.
      </p>

      <p class="hero-base" data-animate="hero-text">
        {site.base}; living around the world
      </p>

      <a href="#work" class="hero-jump" data-animate="hero-text">
        See the work
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 3v10M4 9l4 4 4-4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--nav-height) + 48px) 24px 72px;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero-type {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    /* Leaves the right of the composition to the portrait. */
    max-width: min(60ch, 62%);
  }

  /* --- The headline ------------------------------------------------------- */

  .hero-headline {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    font-weight: var(--weight-black);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
  }

  .hl-line {
    display: block;
    /* The width axis must not be able to trigger a rewrap mid-animation. */
    white-space: nowrap;
    /* Entrance start state; the script settles these to 100 / 1. */
    font-variation-settings: "wdth" 68;
    opacity: 0;
  }

  /* The third line carries the differentiation, so it carries the accent —
     rather than spending a decorative divider on the job. */
  .hl-line:last-child {
    color: var(--accent);
  }

  /* --- Supporting type ---------------------------------------------------- */

  .hero-lede {
    font-size: var(--size-lede);
    line-height: var(--leading-snug);
    color: var(--text-secondary);
    max-width: 46ch;
  }

  .hero-lede strong {
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
  }

  .hero-base {
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-muted);
  }

  .hero-jump {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: var(--size-sm);
    color: var(--text-secondary);
    border-bottom: 1px solid
      color-mix(in srgb, var(--border-color) 25%, transparent);
    padding-bottom: 2px;
    transition: color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease);
  }

  .hero-jump svg {
    transition: translate var(--duration-normal) var(--ease);
  }

  .hero-jump:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .hero-jump:hover svg {
    translate: 0 3px;
  }

  /* --- Portrait ----------------------------------------------------------- */

  .hero-portrait {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: min(50vw, 720px);
    height: 92%;
    pointer-events: none;
  }

  .hero-portrait img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom right;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-jump svg,
    .hero-jump:hover svg {
      transition: none;
      translate: 0;
    }
  }

  @media (max-width: 1100px) {
    .hero-type {
      max-width: 72%;
    }
  }

  @media (max-width: 900px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      /* No min-height on the type block: the old 60vh floor produced ~250px of
         empty space on the highest-value screen. */
      min-height: 0;
      padding: calc(var(--nav-height) + 28px) 24px 56px;
    }

    .hero-portrait {
      position: relative;
      order: -1;
      width: 100%;
      max-width: 380px;
      height: auto;
      aspect-ratio: 1 / 1;
      margin: 0 auto 4px;
      align-self: center;
    }

    .hero-portrait img {
      object-position: center bottom;
    }

    .hero-type {
      max-width: none;
      gap: 22px;
    }

    .hl-line {
      /* Below this width the three-line composition cannot hold nowrap without
         shrinking the type out of its own display register. */
      white-space: normal;
    }

    .hero-headline {
      font-size: clamp(2rem, 8.2vw, 3rem);
    }

    .hero-lede {
      font-size: var(--size-md);
    }
  }
</style>

<script>
  import { gsap } from "gsap"

  const lines = [...document.querySelectorAll<HTMLElement>("[data-hl-line]")]
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

  // The width axis is this page's one authored moment. Archivo's wdth runs
  // 62–125; the headline rests at 100 and is pushed wider by scroll energy, so
  // the type responds to the reader instead of looping at them. This replaced
  // seven animated sine waves — audio iconography on a cloud-architecture page.
  const REST = 100
  const MAX = 108
  const START = 68

  if (lines.length) {
    const write = (el: HTMLElement, w: number) => {
      el.style.fontVariationSettings = `"wdth" ${w.toFixed(1)}`
    }

    if (reduceMotion) {
      // Settled and legible. Not a degraded version — just the static one.
      lines.forEach((el) => {
        write(el, REST)
        el.style.opacity = "1"
      })
    } else {
      const state = lines.map(() => ({ w: START, target: REST }))

      // Entrance: each line expands into place. Condensed-to-settled reads as
      // type arriving, rather than as one more thing sliding up the page.
      lines.forEach((el, i) => {
        const s = state[i]
        gsap.to(s, {
          w: REST,
          duration: 1.1,
          delay: 0.15 + i * 0.13,
          ease: "power3.out",
          onUpdate: () => write(el, s.w),
        })
        gsap.to(el, {
          opacity: 1,
          duration: 0.7,
          delay: 0.15 + i * 0.13,
          ease: "power2.out",
        })
      })

      // Scroll energy, sampled cheaply and decayed. No ScrollTrigger required.
      let lastY = window.scrollY
      let energy = 0

      window.addEventListener(
        "scroll",
        () => {
          const y = window.scrollY
          energy += Math.abs(y - lastY)
          lastY = y
        },
        { passive: true }
      )

      const clamp = gsap.utils.clamp(REST, MAX)

      gsap.ticker.add(() => {
        energy *= 0.88
        if (energy < 0.05) energy = 0

        const push = clamp(REST + energy * 0.22)

        lines.forEach((el, i) => {
          const s = state[i]
          // Later lines lag, so the response ripples down the headline.
          const follow = 0.16 - i * 0.035
          s.target = push
          const next = s.w + (s.target - s.w) * follow
          // Only touch the DOM when the axis actually moved: this property
          // reflows the line, so a no-op write is not free.
          if (Math.abs(next - s.w) > 0.12) {
            s.w = next
            write(el, s.w)
          }
        })
      })
    }
  }
</script>
