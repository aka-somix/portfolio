---

---

<section class="hero" id="hero">
  <div class="hero-empty"></div>
  <div class="hero-image-col" data-animate="hero-bg">
    <img src="/images/Hero.png" alt="" />
  </div>
  <div class="hero-card">
    <h1 class="hero-heading" data-animate="hero-text">Ciao!</h1>
    <div class="hero-divider"></div>
    <p class="hero-intro" data-animate="hero-text">
      I'm <strong>Salvatore</strong> — a Software Engineer crafting
      performant, accessible digital experiences.
    </p>
    <p class="hero-tagline" data-animate="hero-text">Based in Italy; Traveling the World</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
  }

  .hero-empty {
    width: 48%;
    flex-shrink: 0;
  }

  .hero-image-col {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .hero-image-col img {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom right;
    display: block;
  }

  .hero-card {
    position: absolute;
    left: 6%;
    bottom: 14%;
    width: 38%;
    padding: 44px 40px;
    background: rgba(21, 23, 61, 0.55);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: none;
    border-radius: var(--radius);
  }

  .hero-heading {
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
    color: var(--text-primary);
  }

  .hero-divider {
    width: 90%;
    height: 4px;
    background: var(--accent);
    margin-bottom: 20px;
    border-radius: 2px;
  }

  .hero-intro {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 10px;
  }

  .hero-intro strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .hero-tagline {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .hero {
      flex-direction: column;
      min-height: auto;
    }

    .hero-empty {
      display: none;
    }

    .hero-image-col {
      position: relative;
      flex: none;
      height: 40vh;
      width: 100%;
    }

    .hero-card {
      position: relative;
      left: auto;
      bottom: auto;
      width: 100%;
      flex: 1;
      min-height: 60vh;
      padding: 40px 24px;
      background: var(--bg-primary);
      border: none;
      border-radius: 0;
    }

    .hero-intro {
      max-width: 100%;
    }
  }
</style>
