---
import { hero, site } from "../lib/content"

const channels = await site()
const content = await hero()

const headline = content.headline
const PORTRAIT = content.portrait.src
---

<section class="hero" id="hero">
  <!-- The page's one h1. Visually hidden, announced by screen readers, and
       absolutely positioned so it takes part in no layout: `.hero` is
       position:relative + overflow:hidden, so it cannot affect geometry or
       scroll extent. It lives here rather than inside `.hero-type`, which is a
       flex column with a 28px gap that an in-flow child would widen. The
       visible display headline below is the h2. -->
  <h1 class="sr-only">{content.srHeadline}</h1>

  <!-- Faceted light field: the same low-poly material as the portrait, lit by a
       light source that follows the pointer. Portrait and ground share one
       light, so the illustration reads as native to the page rather than
       placed on it. The ground and the rake respond; the figure's geometry is
       fixed. Static single render on touch and reduced-motion. -->
  <canvas class="hero-facets" data-facets aria-hidden="true"></canvas>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-portrait" data-animate="hero-bg" data-portrait>
    <div class="portrait-figure">
      <img
        src={PORTRAIT}
        alt={content.portrait.alt}
        width="1440"
        height="1440"
        fetchpriority="high"
        decoding="async"
      />
      <!-- Gold raking across the facets, masked by the portrait's own alpha and
           tracking the same light that shades the ground. The figure itself
           never moves: a solid object does not tilt when a light does, only its
           shading changes. The rake is the whole of the portrait's response. -->
      <div
        class="portrait-sheen"
        style={`--sheen-img: url(${PORTRAIT})`}
        aria-hidden="true"
      >
      </div>
    </div>
  </div>

  <div class="hero-inner rail">
    <div class="hero-type">
      <h2 class="hero-headline">
        {
          headline.map((line) => (
            <span class="hl-line" data-hl-line>
              {line}
            </span>
          ))
        }
      </h2>

      <p class="hero-lede" data-animate="hero-text">
        {content.lede.before}<strong>{content.lede.name}</strong>{content.lede.after}
      </p>

      <p class="hero-base" data-animate="hero-text">
        {channels.base}{content.baseSuffix}
      </p>

      <a href="#work" class="hero-jump" data-animate="hero-text">
        {content.jumpLabel}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 3v10M4 9l4 4 4-4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--nav-height) + 48px) 24px 72px;
    overflow: hidden;
    isolation: isolate;
  }

  .hero-facets {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Keeps the type column on near-solid ground so the facet field can never
     erode text contrast, while the effect stays fully visible to the right. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      var(--bg-primary) 0%,
      color-mix(in srgb, var(--bg-primary) 82%, transparent) 34%,
      transparent 60%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    width: 100%;
  }

  .hero-type {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    max-width: min(60ch, 62%);
  }

  /* --- The headline ------------------------------------------------------- */

  .hero-headline {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    font-weight: var(--weight-black);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
  }

  .hl-line {
    display: block;
    /* Held so the load-in expansion cannot change how a line wraps. */
    white-space: nowrap;
    font-variation-settings: "wdth" 68;
    opacity: 0;
  }

  .hl-line:last-child {
    color: var(--accent);
  }

  /* --- Supporting type ---------------------------------------------------- */

  .hero-lede {
    font-size: var(--size-lede);
    line-height: var(--leading-snug);
    color: var(--text-secondary);
    max-width: 42ch;
  }

  .hero-lede strong {
    color: var(--text-primary);
    font-weight: var(--weight-semibold);
  }

  .hero-base {
    font-family: var(--font-mono);
    font-size: var(--size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-muted);
  }

  .hero-jump {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: var(--size-sm);
    color: var(--text-secondary);
    border-bottom: 1px solid
      color-mix(in srgb, var(--border-color) 25%, transparent);
    padding-bottom: 2px;
    transition: color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease);
  }

  .hero-jump svg {
    transition: translate var(--duration-normal) var(--ease);
  }

  .hero-jump:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .hero-jump:hover svg {
    translate: 0 3px;
  }

  /* --- Portrait ----------------------------------------------------------- */

  .hero-portrait {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 2;
    width: min(50vw, 720px);
    height: 92%;
    pointer-events: none;
  }

  .portrait-figure {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .portrait-figure img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom right;
  }

  .portrait-sheen {
    position: absolute;
    inset: 0;
    /* Masked by the portrait's own alpha, so the light lands on the figure and
       nowhere else. */
    mask-image: var(--sheen-img);
    mask-size: contain;
    mask-position: bottom right;
    mask-repeat: no-repeat;
    -webkit-mask-image: var(--sheen-img);
    -webkit-mask-size: contain;
    -webkit-mask-position: bottom right;
    -webkit-mask-repeat: no-repeat;
    background-image: linear-gradient(
      108deg,
      transparent 32%,
      color-mix(in srgb, var(--accent) 82%, #fff) 47%,
      transparent 60%
    );
    background-size: 320% 100%;
    background-position: calc(var(--sheen, 0.5) * 100%) 0;
    background-repeat: no-repeat;
    /* soft-light rather than overlay, at a third of the strength: the rake
       should catch the existing facets, not repaint them. */
    mix-blend-mode: soft-light;
    opacity: 0.34;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-jump svg,
    .hero-jump:hover svg {
      transition: none;
      translate: 0;
    }
  }

  @media (max-width: 1100px) {
    .hero-type {
      max-width: 72%;
    }
  }

  @media (max-width: 900px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      min-height: 0;
      padding: calc(var(--nav-height) + 28px) 24px 56px;
    }

    .hero-scrim {
      /* Vertical on a stacked layout: the type sits below the portrait here. */
      background: linear-gradient(
        to bottom,
        transparent 0%,
        color-mix(in srgb, var(--bg-primary) 80%, transparent) 38%,
        var(--bg-primary) 62%
      );
    }

    .hero-portrait {
      position: relative;
      order: -1;
      width: 100%;
      max-width: 380px;
      height: auto;
      aspect-ratio: 1 / 1;
      margin: 0 auto 4px;
      align-self: center;
    }

    .portrait-figure img {
      object-position: center bottom;
    }

    .portrait-sheen {
      mask-position: center bottom;
      -webkit-mask-position: center bottom;
    }

    .hero-type {
      max-width: none;
      gap: 22px;
    }

    .hl-line {
      white-space: normal;
    }

    .hero-headline {
      font-size: clamp(2rem, 8.2vw, 3rem);
    }

    .hero-lede {
      font-size: var(--size-md);
      max-width: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap"

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches
  // No cursor to follow, or motion is unwelcome: render once, beautifully, and
  // never start a loop. This is the composed still, not a degraded version.
  const interactive = finePointer && !reduceMotion

  /* ======================================================================
   * Headline load-in
   * The scroll-driven width response is deliberately gone. Below 768px the
   * lines are allowed to wrap, so a width change mid-scroll could re-wrap the
   * headline and shift everything beneath it. The load-in runs once, before
   * any scrolling, and settles.
   * ==================================================================== */
  const lines = [...document.querySelectorAll<HTMLElement>("[data-hl-line]")]
  const REST = 100
  const START = 68

  if (lines.length) {
    const write = (el: HTMLElement, w: number) => {
      el.style.fontVariationSettings = `"wdth" ${w.toFixed(1)}`
    }

    if (reduceMotion) {
      lines.forEach((el) => {
        write(el, REST)
        el.style.opacity = "1"
      })
    } else {
      lines.forEach((el, i) => {
        const s = { w: START }
        gsap.to(s, {
          w: REST,
          duration: 1.1,
          delay: 0.15 + i * 0.13,
          ease: "power3.out",
          onUpdate: () => write(el, s.w),
        })
        gsap.to(el, {
          opacity: 1,
          duration: 0.7,
          delay: 0.15 + i * 0.13,
          ease: "power2.out",
        })
      })
    }
  }

  /* ======================================================================
   * Faceted light field
   * ==================================================================== */
  const canvas = document.querySelector<HTMLCanvasElement>("[data-facets]")
  const hero = document.querySelector<HTMLElement>(".hero")
  const portrait = document.querySelector<HTMLElement>("[data-portrait]")

  if (canvas && hero) {
    const ctx = canvas.getContext("2d", { alpha: true })

    // Where the light rests with no pointer: high and right, so it rakes across
    // the portrait's face rather than sitting in dead space.
    const HOME = { x: 0.68, y: 0.3 }
    const CELL = 118

    type Tri = {
      a: [number, number]
      b: [number, number]
      c: [number, number]
      cx: number
      cy: number
      nx: number
      ny: number
    }

    let tris: Tri[] = []
    let W = 0
    let H = 0

    // Deterministic jitter, so the lattice is identical across resizes and
    // never appears to "reshuffle" when the window changes.
    let seed = 20260826
    const rnd = () => {
      seed = (seed * 1664525 + 1013904223) % 4294967296
      return seed / 4294967296
    }

    const build = () => {
      const rect = hero.getBoundingClientRect()
      W = Math.max(1, Math.round(rect.width))
      H = Math.max(1, Math.round(rect.height))
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      canvas.width = Math.round(W * dpr)
      canvas.height = Math.round(H * dpr)
      if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0)

      seed = 20260826
      const cols = Math.ceil(W / CELL) + 1
      const rows = Math.ceil(H / CELL) + 1
      const pts: [number, number][][] = []

      for (let r = 0; r <= rows; r++) {
        const row: [number, number][] = []
        for (let c = 0; c <= cols; c++) {
          const edge = r === 0 || c === 0 || r === rows || c === cols
          const jx = edge ? 0 : (rnd() - 0.5) * CELL * 0.62
          const jy = edge ? 0 : (rnd() - 0.5) * CELL * 0.62
          row.push([c * CELL + jx, r * CELL + jy])
        }
        pts.push(row)
      }

      tris = []
      const push = (
        a: [number, number],
        b: [number, number],
        c: [number, number]
      ) => {
        const cx = (a[0] + b[0] + c[0]) / 3
        const cy = (a[1] + b[1] + c[1]) / 3
        // A per-facet orientation. This is what makes neighbouring triangles
        // catch the light differently, the way a faceted surface does.
        const ang = rnd() * Math.PI * 2
        tris.push({ a, b, c, cx, cy, nx: Math.cos(ang), ny: Math.sin(ang) })
      }

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const p00 = pts[r][c]
          const p10 = pts[r][c + 1]
          const p11 = pts[r + 1][c + 1]
          const p01 = pts[r + 1][c]
          push(p00, p10, p11)
          push(p00, p11, p01)
        }
      }
    }

    const light = { x: 0, y: 0 }
    const target = { x: 0, y: 0 }
    let drawnX = Number.NaN
    let drawnY = Number.NaN

    const setHome = () => {
      target.x = W * HOME.x
      target.y = H * HOME.y
    }

    const draw = () => {
      if (!ctx) return
      ctx.clearRect(0, 0, W, H)
      const reach = Math.hypot(W, H) * 0.62

      for (const t of tris) {
        const dx = light.x - t.cx
        const dy = light.y - t.cy
        const dist = Math.hypot(dx, dy) || 1
        // Facing the light, falling off with distance.
        const facing = (dx / dist) * t.nx + (dy / dist) * t.ny
        const falloff = Math.max(0, 1 - dist / reach)
        const lit = Math.max(0, facing) * falloff

        // Base stays close to the page ground so the field reads as material
        // rather than as a pattern laid on top of it.
        const r = 22 + lit * 25
        const g = 17 + lit * 17
        const b = 49 + lit * 40
        ctx.fillStyle = `rgb(${r | 0} ${g | 0} ${b | 0})`
        ctx.beginPath()
        ctx.moveTo(t.a[0], t.a[1])
        ctx.lineTo(t.b[0], t.b[1])
        ctx.lineTo(t.c[0], t.c[1])
        ctx.closePath()
        ctx.fill()

        // Gold only on the brightest facet edges, and only as a hairline: a
        // gold fill behind the type would wreck its contrast.
        if (lit > 0.74) {
          ctx.strokeStyle = `rgba(238, 167, 39, ${((lit - 0.74) / 0.26) * 0.38})`
          ctx.lineWidth = 1
          ctx.stroke()
        }
      }
      drawnX = light.x
      drawnY = light.y
    }

    // The figure's geometry is fixed. The only thing the light changes on the
    // portrait is where the gold rake falls, which is what a light actually
    // does to a solid object. Runs for the still render too, so the composed
    // still is lit from the same home position as the ground beneath it.
    const applyRake = () => {
      if (!portrait) return
      const nx = W ? light.x / W - 0.5 : 0
      portrait.style.setProperty("--sheen", (0.5 + nx * 0.9).toFixed(3))
    }

    build()
    setHome()
    light.x = target.x
    light.y = target.y
    draw()
    applyRake()

    if (interactive) {
      window.addEventListener(
        "pointermove",
        (e: PointerEvent) => {
          const rect = hero.getBoundingClientRect()
          target.x = e.clientX - rect.left
          target.y = e.clientY - rect.top
        },
        { passive: true }
      )

      // Leaving the window returns the light home rather than freezing it
      // wherever the cursor happened to exit.
      document.addEventListener("pointerleave", setHome)
      window.addEventListener("blur", setHome)

      gsap.ticker.add(() => {
        light.x += (target.x - light.x) * 0.075
        light.y += (target.y - light.y) * 0.075
        // Redraw only when the light actually moved. At rest this costs nothing.
        if (Math.abs(light.x - drawnX) > 0.4 || Math.abs(light.y - drawnY) > 0.4) {
          draw()
          applyRake()
        }
      })
    }

    let resizeRaf = 0
    window.addEventListener("resize", () => {
      cancelAnimationFrame(resizeRaf)
      resizeRaf = requestAnimationFrame(() => {
        build()
        if (!interactive) setHome()
        light.x = target.x
        light.y = target.y
        draw()
        applyRake()
      })
    })
  }
</script>
