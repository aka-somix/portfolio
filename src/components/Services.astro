---
import ServiceCard from "./ServiceCard.astro"
import { services } from "../data/services"
import { sections } from "../data/sections"

const section = sections.services
---

<section class="services" id="services" data-services-section>
  <div class="services-header" data-services-header>
    <h2 class="section-label">{section.title}</h2>
    <span class="section-count">0{services.length}</span>
  </div>
  <p class="section-description" data-services-header>{section.description}</p>
  <p class="services-hint" data-services-header>Drag to explore</p>
  <div class="services-track-wrapper">
    <div class="services-track" data-services-track>
      {services.map((service) => (
        <ServiceCard image={service.image} title={service.title} description={service.description} imageAlt={service.imageAlt} />
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding: 100px 24px;
    overflow-x: clip;
  }

  .services-header {
    max-width: var(--max-width);
    margin: 0 auto 8px;
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .section-label {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .section-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .section-description {
    max-width: var(--max-width);
    margin: 0 auto 8px;
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .services-hint {
    max-width: var(--max-width);
    margin: 0 auto 16px;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .services-track-wrapper {
    position: relative;
    overflow: visible;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .services-track {
    position: relative;
    min-height: 215px;
    width: 100%;
  }
</style>
