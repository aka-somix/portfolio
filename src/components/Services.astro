---
import ServiceCard from "./ServiceCard.astro"
import { services, ui } from "../lib/content"

const content = await services()
const section = content.header
const labels = (await ui()).services
const items = content.items
---

<section class="services" id="services" data-services-section>
  <div class="services-header rail" data-services-header>
    <h2 class="section-label">{section.title}</h2>
  </div>
  <div class="rail" data-services-header>
    <p class="section-description">{section.description}</p>
  </div>
  <p class="services-hint rail" data-services-header>
    {content.hint}
  </p>

  <div class="services-deck rail">
    <div
      class="services-track-wrapper"
      data-services-wrapper
      role="group"
      aria-label={labels.deckAriaLabel}
      tabindex="0"
    >
      <div class="services-track" data-services-track>
        {
          items.map((service, i) => (
            <ServiceCard
              image={service.image}
              title={service.title}
              tag={service.tag}
              description={service.description}
              help={service.help}
              imageAlt={service.imageAlt}
              index={i}
              total={items.length}
            />
          ))
        }
      </div>
    </div>

    <span class="deck-falloff" aria-hidden="true"></span>

    <div class="deck-controls">
      <button class="deck-arrow" data-deck-prev aria-label={labels.prevAriaLabel}>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M13 4l-6 6 6 6"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
      <span class="deck-indicator tabular" data-deck-indicator aria-live="polite">
        01/{String(items.length).padStart(2, "0")}
      </span>
      <button class="deck-arrow" data-deck-next aria-label={labels.nextAriaLabel}>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M7 4l6 6-6 6"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .services {
    padding: 100px 24px;
    overflow-x: clip;
  }

  /* .section-label / .section-description come from BaseLayout. Only the local
     rhythm belongs here. */
  .services-header {
    margin-bottom: 16px;
  }

  .section-description {
    margin-bottom: 0;
  }

  [data-services-header].rail {
    margin-bottom: 28px;
  }

  .services-hint {
    max-width: var(--max-width);
    margin: 0 auto 36px;
    font-size: var(--size-min);
    font-family: var(--font-mono);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .services-deck {
    position: relative;
  }

  /* Bleeds past the rail to the viewport edge — anchored only to the rail it
     left a strip of un-faded card visible on wide screens. */
  .deck-falloff {
    position: absolute;
    top: 0;
    right: calc((100vw - 100%) / -2);
    width: calc(170px + (100vw - 100%) / 2);
    height: 330px;
    pointer-events: none;
    z-index: 6;
    background: linear-gradient(
      to right,
      transparent,
      var(--bg-primary) 72%
    );
  }

  .services-track-wrapper {
    position: relative;
    /* Room for the card plus the lift and its shadow. */
    height: 330px;
    touch-action: pan-y;
  }

  .services-track {
    position: absolute;
    inset: 0;
  }

  .services-track-wrapper:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 8px;
    border-radius: var(--radius);
  }

  .deck-controls {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 8px;
  }

  .deck-arrow {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--border-color) 45%, transparent);
    border-radius: 50%;
    background: none;
    color: var(--text-secondary);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .deck-arrow:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .deck-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .deck-indicator {
    font-size: var(--size-xs);
    color: var(--text-muted);
    min-width: 56px;
    text-align: center;
  }

  @media (max-width: 768px) {
    .services-track-wrapper {
      height: 320px;
    }

    /* One badge is visible at this width, so there is no neighbour to fade —
       the gradient would only dim the live card. */
    .deck-falloff {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap"

  const wrapper = document.querySelector<HTMLElement>("[data-services-wrapper]")
  const track = document.querySelector<HTMLElement>("[data-services-track]")
  const cards = track
    ? [...track.querySelectorAll<HTMLElement>(".service-card")]
    : []
  const N = cards.length

  const prevBtn = document.querySelector<HTMLButtonElement>("[data-deck-prev]")
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-deck-next]")
  const indicator = document.querySelector<HTMLElement>("[data-deck-indicator]")

  if (wrapper && track && N) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    const clamp = gsap.utils.clamp
    const lerp = gsap.utils.interpolate

    const GAP = 44
    const STACK_OFF_X = 6
    const STACK_OFF_Y = 3
    const STACK_ROT = -0.5

    // Geometry is read from layout, never assumed. The previous implementation
    // computed the stack target once at init, so it was stale after any resize.
    let SLOT = 0
    let STACK_LEFT = 0
    const measure = () => {
      SLOT = cards[0].offsetWidth + GAP
      STACK_LEFT = -(wrapper.getBoundingClientRect().left + cards[0].offsetWidth * 0.5)
    }
    measure()

    const baseRots = cards.map((_, i) => (i - (N - 1) / 2) * 1.5)
    let progress = 0

    const layout = (p: number) => {
      progress = clamp(0, N - 1, p)
      cards.forEach((card, i) => {
        const depth = Math.max(0, Math.min(1, progress - i))
        const baseRot = baseRots[i]
        const spreadX = (i - progress) * SLOT
        const stackX = STACK_LEFT + i * STACK_OFF_X
        gsap.set(card, {
          x: lerp(spreadX, stackX, depth),
          y: lerp(0, i * STACK_OFF_Y, depth),
          rotation: lerp(baseRot, baseRot + i * STACK_ROT, depth),
          zIndex: depth >= 1 ? i : N + 1,
        })
      })
    }

    const active = () => Math.round(progress)

    const syncControls = () => {
      const i = active()
      if (indicator) {
        indicator.textContent = `${String(i + 1).padStart(2, "0")}/${String(N).padStart(2, "0")}`
      }
      if (prevBtn) prevBtn.disabled = i <= 0
      if (nextBtn) nextBtn.disabled = i >= N - 1
    }

    // --- Flip -------------------------------------------------------------
    const setFlipped = (card: HTMLElement, on: boolean) => {
      card.setAttribute("aria-expanded", on ? "true" : "false")
      const front = card.querySelector(".badge-face--front")
      const back = card.querySelector(".badge-face--back")
      // Keep the hidden face out of the accessibility tree so a screen reader
      // is not read both sides of the badge at once.
      front?.setAttribute("aria-hidden", on ? "true" : "false")
      back?.setAttribute("aria-hidden", on ? "false" : "true")
    }

    cards.forEach((card) => setFlipped(card, false))

    const closeAll = () => cards.forEach((card) => setFlipped(card, false))

    // --- Pick-up ----------------------------------------------------------
    // The lift lives on .badge-lift, a separate transform layer, so it can
    // never be overwritten by the layout pass above.
    const liftOf = (card: HTMLElement) =>
      card.querySelector<HTMLElement>(".badge-lift")

    const pickUp = (card: HTMLElement) => {
      const el = liftOf(card)
      if (!el || reduceMotion) return
      gsap.to(el, {
        scale: 1.045,
        y: -12,
        duration: 0.22,
        ease: "power2.out",
        overwrite: "auto",
      })
      const face = card.querySelectorAll<HTMLElement>(".badge-face")
      gsap.to(face, {
        boxShadow: "0 26px 48px -14px rgba(0,0,0,0.65)",
        duration: 0.22,
        overwrite: "auto",
      })
    }

    const putDown = (card: HTMLElement) => {
      const el = liftOf(card)
      if (!el) return
      gsap.to(el, {
        scale: 1,
        y: 0,
        rotation: 0,
        // Overshoot on release: the badge settles rather than snapping dead.
        duration: reduceMotion ? 0.2 : 0.55,
        ease: reduceMotion ? "power2.out" : "back.out(1.7)",
        overwrite: "auto",
      })
      const face = card.querySelectorAll<HTMLElement>(".badge-face")
      gsap.to(face, {
        boxShadow: "0 3px 10px -2px rgba(0,0,0,0.4)",
        duration: 0.4,
        overwrite: "auto",
      })
    }

    // --- Navigation -------------------------------------------------------
    let snapTween: gsap.core.Tween | null = null

    const snapTo = (target: number) => {
      const to = clamp(0, N - 1, Math.round(target))
      const proxy = { p: progress }
      snapTween?.kill()
      snapTween = gsap.to(proxy, {
        p: to,
        duration: reduceMotion ? 0 : 0.42,
        ease: "power3.out",
        onUpdate: () => layout(proxy.p),
        onComplete: syncControls,
      })
      syncControls()
    }

    const step = (delta: number) => {
      closeAll()
      snapTo(active() + delta)
    }

    prevBtn?.addEventListener("click", () => step(-1))
    nextBtn?.addEventListener("click", () => step(1))

    wrapper.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowRight") {
        e.preventDefault()
        step(1)
      } else if (e.key === "ArrowLeft") {
        e.preventDefault()
        step(-1)
      } else if (e.key === "Escape") {
        closeAll()
      }
    })

    // Keep the focused badge on screen when TABBING through them — but only for
    // keyboard focus. Snapping on pointer focus slid the badge out from under
    // the cursor before its click could land, which swallowed the flip.
    let keyboardNav = false
    window.addEventListener("keydown", (e) => {
      if (e.key === "Tab") keyboardNav = true
    })
    wrapper.addEventListener("pointerdown", () => {
      keyboardNav = false
    })

    cards.forEach((card, i) => {
      card.addEventListener("focus", () => {
        if (keyboardNav && active() !== i) snapTo(i)
      })
    })

    // --- Drag -------------------------------------------------------------
    let dragging = false
    let moved = false
    let startX = 0
    let startProgress = 0
    let velX = 0
    let lastX = 0
    let lastT = 0
    let held: HTMLElement | null = null

    const DRAG_THRESHOLD = 8

    wrapper.addEventListener("pointerdown", (e: PointerEvent) => {
      if ((e.target as HTMLElement).closest(".deck-arrow")) return
      snapTween?.kill()
      dragging = true
      moved = false
      startX = e.clientX
      startProgress = progress
      velX = 0
      lastX = e.clientX
      lastT = performance.now()
      held = (e.target as HTMLElement).closest<HTMLElement>(".service-card")
        ?? cards[active()]
      // Capture is deliberately NOT taken here. While a pointer is captured,
      // the following click retargets to the capturing element, so taking it on
      // pointerdown swallows the tap that flips the badge. It is taken below,
      // once the movement threshold proves this is a drag and not a tap.
    })

    wrapper.addEventListener("pointermove", (e: PointerEvent) => {
      if (!dragging) return
      const dx = e.clientX - startX

      if (!moved && Math.abs(dx) > DRAG_THRESHOLD) {
        moved = true
        // Only now is this a drag rather than a tap — lift on intent, so a tap
        // to flip never triggers the pick-up, and claim the pointer here so the
        // gesture survives leaving the element.
        try {
          wrapper.setPointerCapture(e.pointerId)
        } catch {
          /* capture is best-effort; the drag still tracks without it */
        }
        if (held) pickUp(held)
      }
      if (!moved) return

      const now = performance.now()
      const dt = now - lastT
      if (dt > 0) velX = (e.clientX - lastX) / dt
      lastX = e.clientX
      lastT = now

      layout(startProgress - dx / SLOT)
      syncControls()

      // Rotation follows the hand, so the badge lags rather than sliding rigid.
      if (held && !reduceMotion) {
        const el = liftOf(held)
        if (el) {
          gsap.to(el, {
            rotation: clamp(-7, 7, velX * -3.2),
            duration: 0.28,
            ease: "power2.out",
            overwrite: "auto",
          })
        }
      }
    })

    const endDrag = () => {
      if (!dragging) return
      dragging = false
      if (held) putDown(held)
      if (moved) {
        // Throw: project where the flick was heading.
        snapTo(progress - (velX * 130) / SLOT)
      }
      held = null
    }

    wrapper.addEventListener("pointerup", endDrag)
    wrapper.addEventListener("pointercancel", endDrag)

    // A drag that started on a badge must not also fire its click and flip it.
    cards.forEach((card) => {
      card.addEventListener("click", (e) => {
        if (moved) {
          e.preventDefault()
          moved = false
          return
        }
        const i = cards.indexOf(card)
        // A badge behind the front one comes forward first. Turning it over is
        // the second gesture, which matches handling the physical object and
        // avoids flipping something the reader cannot fully see.
        if (active() !== i) {
          closeAll()
          snapTo(i)
          return
        }
        const isOpen = card.getAttribute("aria-expanded") === "true"
        closeAll()
        setFlipped(card, !isOpen)
      })
    })

    // --- Resize -----------------------------------------------------------
    let resizeRaf = 0
    window.addEventListener("resize", () => {
      cancelAnimationFrame(resizeRaf)
      resizeRaf = requestAnimationFrame(() => {
        measure()
        layout(active())
        syncControls()
      })
    })

    layout(0)
    syncControls()
  }
</script>
