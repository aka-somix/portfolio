---
export interface Props {
  title: string
  description: string
  roles: string[]
  slug: string
  index: number
  total: number
  image?: string
  imageAttribution?: string
  imageAlt?: string
}

const { title, description, roles, slug, index, total, image, imageAttribution, imageAlt } = Astro.props
const alt = imageAlt ?? `${title} project screenshot`
---

<div class="work-card">
  <div class="card-left">
    <span class="card-counter">{String(index + 1).padStart(2, "0")}/{String(total).padStart(2, "0")}</span>
    <h3 class="card-title">{title}</h3>
    <p class="card-description">{description}</p>
    <div class="card-roles">
      {roles.map((role) => (
        <span class="role-tag">{role}</span>
      ))}
    </div>
  </div>
  <div class="card-right">
    <div class="card-image">
      {image ? (
        <img class="card-img" src={image} alt={alt} loading="lazy" />
      ) : (
        <div class="image-placeholder">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
            <rect x="4" y="8" width="40" height="32" rx="4" stroke="currentColor" stroke-width="1.5" fill="none" />
            <circle cx="28" cy="22" r="6" stroke="currentColor" stroke-width="1.5" />
            <path d="M8 36l10-10 8 8 6-6 8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="placeholder-label">Project image</span>
        </div>
      )}
      {imageAttribution && <span class="card-image-attribution">{imageAttribution}</span>}
    </div>
    <a href={`/work/${slug}`} class="card-cta">
      <span data-cta-label>
        Look inside
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span data-cta-alt aria-hidden="true">👀👀👀👀👀👀</span>
    </a>
  </div>
</div>

<style>
  .work-card {
    width: 75vw;
    flex-shrink: 0;
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 40px;
    background: var(--bg-surface);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: none;
    border-radius: var(--radius);
    padding: 40px;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }

  .card-left {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .card-counter {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .card-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .card-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
  }

  .role-tag {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
  }

  .card-right {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .card-image {
    position: relative;
    flex: 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
  }

  .card-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--bg-accent), var(--accent));
    opacity: 0.40;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-image-attribution {
    display: block;
    font-size: 0.55rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    opacity: 0.6;
    margin-top: 4px;
    text-align: right;
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    border: 2px dashed var(--border-color);
    border-radius: var(--radius-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--text-muted);
  }

  .placeholder-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: var(--font-mono);
  }

  .card-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-primary);
    padding: 10px 20px;
    border: 1px solid var(--border-color);
    background: transparent;
    align-self: flex-start;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }

  .card-cta:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg-primary);
  }

  .card-cta [data-cta-label] {
    display: block;
    transition: opacity 0.2s ease, transform 0.2s ease;
    opacity: 1;
    transform: translateY(0);
  }

  .card-cta:hover [data-cta-label] {
    opacity: 0;
    transform: translateY(-6px);
  }

  .card-cta [data-cta-alt] {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(6px);
    font-size: 1.25rem;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .card-cta:hover [data-cta-alt] {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .work-card {
      aspect-ratio: auto;
      grid-template-columns: 1fr;
      padding: 24px;
      gap: 24px;
    }
  }
</style>
