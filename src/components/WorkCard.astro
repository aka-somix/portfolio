---
import { ui } from "../lib/content"

export interface Props {
  title: string
  arena: string
  lede: string
  responsibilities: string[]
  learned: string
  roles: string[]
  client: string
  years: string
  spec: { label: string; value: string }[]
  specPlaceholder: boolean
  slug: string
  index: number
  total: number
}

const {
  title,
  arena,
  lede,
  responsibilities,
  learned,
  roles,
  client,
  years,
  spec,
  specPlaceholder,
  slug,
} = Astro.props

const labels = (await ui()).workCard
const specLabels = (await ui()).workSpec
---

<article class="work-card">
  <div class="card-left">
    <p class="card-arena">{arena}</p>
    <h3 class="card-title">{title}</h3>
    <p class="card-lede">{lede}</p>

    <div class="card-block">
      <h4 class="card-block-title">{labels.held}</h4>
      <ul class="card-list">
        {responsibilities.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="card-block">
      <h4 class="card-block-title">{labels.taught}</h4>
      <p class="card-learned">{learned}</p>
    </div>

    <div class="card-roles">
      {roles.map((role) => <span class="role-tag">{role}</span>)}
    </div>
  </div>

  <div class="card-right">
    <!-- The spec panel: an architect's own artifact, and the one place mono
         does real work (aligned figures). Replaces the stock photograph. -->
    <dl
      class="spec"
      data-spec-placeholder={specPlaceholder ? "true" : undefined}
    >
      <div class="spec-row spec-row--head">
        <dt>{specLabels.client}</dt>
        <dd>{client}</dd>
      </div>
      <div class="spec-row spec-row--head">
        <dt>{specLabels.years}</dt>
        <dd class="tabular">{years}</dd>
      </div>
      {
        spec.map((row) => (
          <div class="spec-row">
            <dt>{row.label}</dt>
            <dd class="tabular">{row.value}</dd>
          </div>
        ))
      }
    </dl>

    <a href={`/work/${slug}`} class="card-cta">
      <span data-cta-label>
        {labels.cta}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <span data-cta-alt aria-hidden="true">{labels.ctaAlt}</span>
    </a>
  </div>
</article>

<style>
  .work-card {
    width: 75vw;
    max-width: var(--max-width);
    flex-shrink: 0;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    background: var(--bg-surface);
    border: 1px solid color-mix(in srgb, var(--border-color) 10%, transparent);
    border-radius: var(--radius);
    padding: 48px;
    overflow: hidden;
  }

  .card-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }

  /* The arena names the world. Not an eyebrow above the title — it is the
     title's subject, set at reading size in its own right. */
  .card-arena {
    font-size: var(--size-sm);
    color: var(--text-muted);
    letter-spacing: var(--tracking-tight);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--size-xl);
    font-weight: var(--weight-black);
    font-stretch: 108%;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    color: var(--text-primary);
    text-wrap: balance;
  }

  /* The lede tier the old scale did not have. */
  .card-lede {
    font-size: var(--size-md);
    line-height: var(--leading-snug);
    color: var(--text-primary);
    max-width: 34ch;
  }

  .card-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .card-block-title {
    font-size: var(--size-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-muted);
  }

  .card-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .card-list li {
    position: relative;
    padding-left: 18px;
    font-size: var(--size-sm);
    line-height: var(--leading-snug);
    color: var(--text-secondary);
    max-width: 46ch;
  }

  .card-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 1px;
    background: var(--accent);
  }

  .card-learned {
    font-size: var(--size-sm);
    line-height: var(--leading-body);
    color: var(--text-secondary);
    max-width: 46ch;
  }

  .card-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .role-tag {
    font-size: var(--size-xs);
    font-family: var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    padding: 5px 10px;
    border-radius: var(--radius-sm);
  }

  .card-right {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  /* --- Spec panel --------------------------------------------------------- */

  .spec {
    display: flex;
    flex-direction: column;
    border-top: 1px solid color-mix(in srgb, var(--border-color) 22%, transparent);
  }

  .spec-row {
    display: grid;
    grid-template-columns: minmax(88px, 0.7fr) 1.3fr;
    gap: 16px;
    align-items: baseline;
    padding: 12px 0;
    border-bottom: 1px solid
      color-mix(in srgb, var(--border-color) 12%, transparent);
  }

  .spec-row dt {
    font-size: var(--size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: color-mix(in srgb, var(--text-secondary) 78%, var(--bg-surface));
  }

  .spec-row dd {
    font-size: var(--size-sm);
    color: var(--text-primary);
    text-align: right;
  }

  .spec-row--head dd {
    color: var(--accent);
    font-weight: var(--weight-medium);
  }

  /* --- CTA (personality preserved) --------------------------------------- */

  .card-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--size-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-primary);
    padding: 14px 22px;
    min-height: 44px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: transparent;
    align-self: flex-start;
    transition: background var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease),
      color var(--duration-fast) var(--ease);
  }

  .card-cta:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg-primary);
  }

  .card-cta [data-cta-label] {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: opacity var(--duration-fast) ease,
      transform var(--duration-fast) ease;
    opacity: 1;
    transform: translateY(0);
  }

  .card-cta:hover [data-cta-label] {
    opacity: 0;
    transform: translateY(-6px);
  }

  .card-cta [data-cta-alt] {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(6px);
    font-size: var(--size-md);
    transition: opacity var(--duration-fast) ease,
      transform var(--duration-fast) ease;
  }

  .card-cta:hover [data-cta-alt] {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-cta [data-cta-label],
    .card-cta [data-cta-alt] {
      transition: opacity var(--duration-fast) ease;
      transform: none;
    }

    .card-cta:hover [data-cta-label] {
      transform: none;
    }

    .card-cta:hover [data-cta-alt] {
      transform: none;
    }
  }

  @media (max-width: 900px) {
    .work-card {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 28px;
    }

    .card-lede {
      max-width: none;
    }
  }

  /* Right-aligned values in a narrow column wrapped badly ("Node.js · Python ·
     PostgreSQL" over three ragged lines). Stack the pair instead. */
  @media (max-width: 560px) {
    .spec-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    .spec-row dd {
      text-align: left;
    }
  }
</style>
