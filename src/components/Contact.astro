---
import { sections } from "../data/sections"
import { site } from "../data/site"

const section = sections.contact
---

<section class="contact" id="contact" data-animate="section">
  <div class="contact-inner rail">
    <div class="contact-head">
      <h2 class="contact-heading">{section.title}</h2>
      <p class="contact-lede">
        Whether you need to scale your cloud architecture, bring AI into your
        product, or just want to brainstorm how to build a global tech team from
        anywhere. Let's connect and make it happen 🤜🤛
      </p>
    </div>

    <!-- The hierarchy is geometric, not typographic: the gold block is measured
         in secondary doors rather than in pixels, so "the booking action leads"
         is a proportion the layout holds rather than a larger font. -->
    <div class="contact-actions">
      <a
        href={site.bookingUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="action action--primary"
      >
        <span class="action-copy">
          <span class="action-title">Book a call</span>
          <span class="action-note">60 minutes, no pitch. Pick a slot</span>
        </span>

        <span class="action-arrow" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path
              d="M5 12h13M13 6l6 6-6 6"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </a>

      <div class="action-secondary-row">
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="action action--secondary"
        >
          <span class="action-title">Message on LinkedIn</span>
          <span class="action-note">Fastest for a quick question</span>
        </a>

        <a href={`mailto:${site.email}`} class="action action--tertiary">
          <span class="action-title">Email</span>
          <span class="action-note">{site.email}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 120px 24px 96px;
    border-bottom: none;
  }

  .contact-head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 56px;
  }

  .contact-heading {
    font-family: var(--font-display);
    font-size: var(--size-section);
    font-weight: var(--weight-black);
    font-stretch: 112%;
    letter-spacing: var(--tracking-display);
    /* Was inheriting body leading (1.6), which rendered this heading with 64px
       of leading on mobile. */
    line-height: var(--leading-tight);
    text-wrap: balance;
    max-width: 22ch;
  }

  .contact-lede {
    font-size: var(--size-md);
    line-height: var(--leading-snug);
    color: var(--text-secondary);
    max-width: 58ch;
  }

  /* --- Actions, in the order a visitor should reach for them -------------- */

  .contact-actions {
    /* The height of one secondary door, and the only number this composition
       is built on. The pair below is a grid track of exactly this height, and
       the gold block is two of them plus the gap. */
    --door: 110px;
    --door-gap: 16px;
    /* How many doors tall the gold block is. A flat 2 made it 236px, which read
       as an empty gold field rather than a lead action; 1.6 keeps it plainly the
       largest thing here without the block dominating the close. */
    --door-span: 1.6;

    display: flex;
    flex-direction: column;
    gap: var(--door-gap);
  }

  .action {
    box-sizing: border-box;
    display: grid;
    align-content: center;
    gap: 6px;
    padding: 22px 26px;
    border-radius: var(--radius);
    border: 1px solid transparent;
    transition: background var(--duration-normal) var(--ease),
      border-color var(--duration-normal) var(--ease),
      transform var(--duration-normal) var(--ease),
      box-shadow var(--duration-normal) var(--ease);
  }

  .action-title {
    font-size: var(--size-md);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }

  .action-note {
    font-size: var(--size-sm);
    color: var(--text-secondary);
  }

  /* --- Primary: the 2:1 block --------------------------------------------- */

  /* The block is twice as tall as a secondary door, so its content spans that
     height instead of floating in the middle of it: title at the top, the
     practical detail at the foot, the way a ticket is set. */
  .action--primary {
    grid-template-columns: minmax(0, 1fr) auto;
    /* Both, deliberately: align-content stretches the single row to the block's
       full height, align-items then lets .action-copy fill it. Inheriting
       align-content: center from .action collapsed the row to its content. */
    align-content: stretch;
    align-items: stretch;
    min-height: calc(var(--door) * var(--door-span) + var(--door-gap));
    padding: 34px 48px;
    background: var(--accent);
    color: var(--bg-primary);
    box-shadow: 0 14px 40px -16px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .action-copy {
    display: grid;
    align-content: space-between;
    gap: 8px;
  }

  .action--primary .action-title {
    font-size: var(--size-2xl);
    font-family: var(--font-display);
    font-weight: var(--weight-black);
    font-stretch: 108%;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }

  .action--primary .action-note {
    font-size: var(--size-base);
    color: color-mix(in srgb, var(--bg-primary) 74%, var(--accent));
  }

  .action-arrow {
    /* On the note's line, not floating at the block's midpoint: the foot of the
       block then carries the detail and the affordance as one row. */
    align-self: end;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--bg-primary) 32%, transparent);
    transition: background var(--duration-normal) var(--ease),
      border-color var(--duration-normal) var(--ease),
      color var(--duration-normal) var(--ease);
  }

  .action-arrow svg {
    transition: translate var(--duration-normal) var(--ease);
  }

  .action--primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 24px 56px -18px color-mix(in srgb, var(--accent) 72%, transparent);
  }

  .action--primary:hover .action-arrow,
  .action--primary:focus-visible .action-arrow {
    background: var(--bg-primary);
    border-color: var(--bg-primary);
    color: var(--accent);
  }

  .action--primary:hover .action-arrow svg {
    translate: 3px 0;
  }

  /* --- Secondary pair ----------------------------------------------------- */

  .action-secondary-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    /* minmax, not a flat track: the pair stacks below 768px and the email
       address is allowed to push a door taller rather than overflow it. */
    grid-auto-rows: minmax(var(--door), auto);
    gap: var(--door-gap);
  }

  .action--secondary,
  .action--tertiary {
    background: color-mix(in srgb, var(--bg-surface) 60%, transparent);
    border-color: color-mix(in srgb, var(--border-color) 14%, transparent);
  }

  .action--secondary:hover,
  .action--tertiary:hover {
    background: var(--bg-surface);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    transform: translateY(-3px);
  }

  .action--tertiary .action-note {
    word-break: break-word;
  }

  @media (prefers-reduced-motion: reduce) {
    .action,
    .action-arrow,
    .action-arrow svg {
      transition: background var(--duration-normal) var(--ease),
        border-color var(--duration-normal) var(--ease),
        color var(--duration-normal) var(--ease);
    }

    .action--primary:hover,
    .action--secondary:hover,
    .action--tertiary:hover {
      transform: none;
    }

    .action--primary:hover .action-arrow svg {
      translate: 0;
    }
  }

  @media (max-width: 768px) {
    .contact {
      padding: 84px 24px 72px;
    }

    /* At 21px the lede ran six lines on a 342px column and read as heavy as
       the heading it sits under. Dropping a tier restores the step. */
    .contact-lede {
      font-size: var(--size-base);
      line-height: var(--leading-body);
    }

    /* The pair stacks here, so the 2:1 ratio no longer has a pair to double.
       The block keeps its lead by scale alone. */
    .action--primary {
      min-height: 152px;
      padding: 28px 26px;
      gap: 20px;
    }

    .action--primary .action-title {
      font-size: var(--size-xl);
    }

    .action--primary .action-note {
      font-size: var(--size-sm);
    }

    .action-arrow {
      width: 48px;
      height: 48px;
    }

  }
</style>
