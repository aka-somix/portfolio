---
import WorkCard from "./WorkCard.astro"
import { certifications, ui, workChapters, workSection } from "../lib/content"

const section = (await workSection()).header
const works = await workChapters()
const certs = await certifications()
const labels = (await ui()).work
---

<section class="work" id="work" data-animate="section">
  <div class="work-header rail">
    <h2 class="section-label">{section.title}</h2>
  </div>
  <div class="rail work-description">
    <p class="section-description">{section.description}</p>
  </div>

  <div class="carousel-wrapper">
    <div class="carousel-viewport" id="carousel-viewport">
      <div class="carousel-track" id="carousel-track">
        {works.map((work, i) => (
          <WorkCard
            title={work.data.title}
            arena={work.data.arena}
            lede={work.data.lede}
            responsibilities={work.data.responsibilities}
            learned={work.data.learned}
            roles={work.data.roles}
            client={work.data.client}
            years={work.data.years}
            spec={work.data.spec}
            specPlaceholder={work.data.specPlaceholder}
            slug={work.id}
            index={i}
            total={works.length}
          />
        ))}
      </div>
    </div>

    <div class="carousel-controls">
      <button class="carousel-arrow" id="carousel-prev" aria-label={labels.prevAriaLabel}>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M13 4l-6 6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <span class="carousel-indicator" id="carousel-indicator">01/{String(works.length).padStart(2, "0")}</span>
      <button class="carousel-arrow" id="carousel-next" aria-label={labels.nextAriaLabel}>
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>

  <div class="cert-subsection">
    <div class="cert-subheading">
      <span class="cert-label">{certs.label}</span>
    </div>
    <div class="cert-viewport">
      <div class="cert-track" id="cert-track">
        {certs.items.map((cert) => (
          <a href={cert.link} target="_blank" rel="noopener noreferrer" class="cert-card">
            <div class="cert-logo">
              <img src={cert.logo} alt="" class="cert-logo-img" loading="lazy" />
              <div class="cert-logo-fallback">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                  <path d="M20 4l4.5 9.1 10 .9-7.3 7 1.7 10L20 27.5 11.1 31l1.7-10-7.3-7 10-.9L20 4z" fill="currentColor" opacity="0.6"/>
                  <circle cx="20" cy="19" r="6" fill="var(--bg-primary)" opacity="0.8"/>
                  <path d="M17 19l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
            <h3 class="cert-name">{cert.name}</h3>
            <span class="cert-issuer">{cert.issuer}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"
  gsap.registerPlugin(ScrollTrigger)

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

  const track = document.getElementById("carousel-track")
  const viewport = document.getElementById("carousel-viewport")
  const prev = document.getElementById("carousel-prev")
  const next = document.getElementById("carousel-next")
  const indicator = document.getElementById("carousel-indicator")
  // `.work-card` rather than track.children: Astro injects a component's
  // hoisted script at the component's own position, which for WorkCard is
  // inside this track, and a stray element there used to be counted as a card.
  const cards = track?.querySelectorAll(".work-card")

  if (track && viewport && prev && next && indicator && cards && cards.length) {
    let i = 0
    const n = cards.length

    // Two paging modes. Wide: the track is transformed, the viewport does not
    // scroll. Narrow: the viewport is a real scroll-snap scroller, because on a
    // touch screen a full-width card that only answers to a 44px arrow reads as
    // broken. The indicator and the arrows drive both.
    const swipeMode = window.matchMedia("(max-width: 900px)") // content-ok: media query

    function animateCardText(card: Element) {
      if (reduceMotion) return
      // Below 900px the blocks and the spec sit inside a collapsed disclosure,
      // so animating them would spend the stagger on nothing.
      const sel = swipeMode.matches
        ? [".card-arena", ".card-title", ".card-lede", ".card-meta", ".card-roles", ".card-fold"]
        : [".card-arena", ".card-title", ".card-lede", ".card-block", ".card-roles", ".spec"]
      const targets = sel.flatMap((q) => [...card.querySelectorAll(q)])
      if (!targets.length) return

      gsap.fromTo(
        targets,
        { y: 24, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.5, stagger: 0.08, ease: "power2.out", delay: 0.15 }
      )
    }

    const setIndicator = () => {
      indicator.textContent = `${String(i + 1).padStart(2, "0")}/${String(n).padStart(2, "0")}`
    }

    // Step by the real card width plus the real gap, read from layout rather
    // than assumed — the card is now max-width capped, so a hardcoded
    // multiplier no longer matches the rendered geometry.
    const place = (behavior: ScrollBehavior) => {
      if (swipeMode.matches) {
        if (track.style.transform) track.style.transform = ""
        const card = cards[i] as HTMLElement
        const left = card.offsetLeft - (viewport.clientWidth - card.offsetWidth) / 2
        viewport.scrollTo({ left, behavior })
      } else {
        if (viewport.scrollLeft) viewport.scrollTo({ left: 0, behavior: "instant" })
        const first = cards[0] as HTMLElement
        const cardW = first.offsetWidth
        const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0
        const offset = (viewport.offsetWidth - cardW) / 2 - i * (cardW + gap)
        track.style.transform = `translateX(${offset}px)` // content-ok: CSS transform value
      }
      setIndicator()
    }

    const go = (to: number) => {
      i = (to + n) % n
      place(reduceMotion ? "instant" : "smooth")
      animateCardText(cards[i])
    }

    prev.onclick = () => go(i - 1)
    next.onclick = () => go(i + 1)

    place("instant")

    // A swipe changes the chapter without touching the arrows, so the indicator
    // and the entrance are driven from the scroll position too. Arrow taps set
    // `i` first, so this never fires the stagger twice.
    let scrollRaf = 0
    viewport.addEventListener(
      "scroll",
      () => {
        if (!swipeMode.matches) return
        cancelAnimationFrame(scrollRaf)
        scrollRaf = requestAnimationFrame(() => {
          const mid = viewport.scrollLeft + viewport.clientWidth / 2
          let nearest = 0
          let best = Infinity
          for (let k = 0; k < n; k++) {
            const c = cards[k] as HTMLElement
            const d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid)
            if (d < best) {
              best = d
              nearest = k
            }
          }
          if (nearest !== i) {
            i = nearest
            setIndicator()
            animateCardText(cards[i])
          }
        })
      },
      { passive: true }
    )

    // Keep the active card centred when the viewport changes, and switch paging
    // mode cleanly when the resize crosses the breakpoint.
    let resizeRaf = 0
    window.addEventListener("resize", () => {
      cancelAnimationFrame(resizeRaf)
      resizeRaf = requestAnimationFrame(() => place("instant"))
    })

    ScrollTrigger.create({
      trigger: document.querySelector(".work"),
      start: "top 75%",
      once: true,
      onEnter: () => animateCardText(cards[0]),
    })
  }

  // === Chapter disclosure (small screens) ===
  // One button drives two panels, because on a wide screen the copy blocks and
  // the spec live in different columns and must not be wrapped together. State
  // lives on the card, so CSS opens both at once. Owned here rather than in
  // WorkCard so the injected script lands outside the carousel track.
  document.querySelectorAll<HTMLButtonElement>("[data-fold-toggle]").forEach((btn) => {
    const card = btn.closest<HTMLElement>(".work-card")
    if (!card) return

    btn.addEventListener("click", () => {
      const open = card.dataset.fold !== "open"
      card.dataset.fold = open ? "open" : "closed"
      btn.setAttribute("aria-expanded", String(open))
    })
  })

  // === Certifications auto-scroll ===
  const certTrack = document.getElementById("cert-track")
  if (certTrack && !reduceMotion) {
    const origCards = [...certTrack.querySelectorAll(".cert-card")]
    origCards.forEach((c) => certTrack.appendChild(c.cloneNode(true)))

    const halfW = certTrack.scrollWidth / 2
    const proxy = { x: 0 }

    const certAnim = gsap.to(proxy, {
      x: halfW,
      duration: 30,
      ease: "none",
      repeat: -1,
      paused: true,
      onUpdate: () => gsap.set(certTrack, { x: -(proxy.x % halfW) }),
    })

    origCards.forEach((card) => {
      const img = card.querySelector<HTMLImageElement>(".cert-logo-img")
      const fb = card.querySelector<HTMLElement>(".cert-logo-fallback")
      if (img && fb) {
        img.addEventListener("error", () => {
          img.style.display = "none"
          fb.style.display = "flex"
        })
      }
    })

    const workSection = document.querySelector(".work")
    if (workSection) {
      ScrollTrigger.create({
        trigger: workSection,
        start: "top bottom",
        end: "bottom top",
        onToggle: (self) => {
          self.isActive ? certAnim.resume() : certAnim.pause()
        },
      })
    }
  }
</script>

<style>
  .work {
    padding: 100px 24px;
  }

  .work-header {
    max-width: var(--max-width);
    margin: 0 auto 40px;
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  /* .section-label and .section-description are defined once, globally, in
     BaseLayout. Only the local rhythm belongs here. */
  .work-description {
    margin-bottom: 48px;
  }

  .carousel-wrapper {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .carousel-viewport {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    /* The neighbouring card intrudes at the edges. Fading it signals "there is
       more" without showing a strip of clipped sentences. */
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 90px,
      #000 calc(100% - 90px),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 90px,
      #000 calc(100% - 90px),
      transparent 100%
    );
  }

  .carousel-track {
    display: flex;
    gap: 48px;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 24px;
    margin-bottom: 100px;
  }

  .carousel-arrow {
    background: none;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .carousel-arrow:hover {
    border-color: var(--text-muted);
    color: var(--text-primary);
  }

  .carousel-indicator {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--size-xs);
    color: var(--text-muted);
    min-width: 56px;
    text-align: center;
  }

  /* Certifications sub-section */
  .cert-subsection {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .cert-subheading {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 28px;
  }

  .cert-label {
    font-size: var(--size-sm);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--text-muted);
  }

  .cert-viewport {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0, #000 60px, #000 calc(100% - 60px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 60px, #000 calc(100% - 60px), transparent 100%);
  }

  .cert-track {
    display: flex;
    gap: 60px;
    padding: 4px 0;
    width: max-content;
  }

  .cert-card {
    width: 280px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 28px 24px 26px;
    background: color-mix(in srgb, var(--bg-surface) 50%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: none;
    border-radius: 12px;
    text-decoration: none;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .cert-card:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
    transform: translateY(-4px);
  }

  .cert-logo {
    width: 10rem;
    height: 10rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .cert-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cert-logo-fallback {
    display: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--text-muted);
  }

  .cert-name {
    font-size: var(--size-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    line-height: var(--leading-snug);
    text-align: center;
  }

  /* Was 8px. This string is what authenticates the certification — it is
     evidence, not fine print. */
  .cert-issuer {
    font-size: var(--size-min);
    font-family: var(--font-mono);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    text-align: center;
  }

  @media (max-width: 900px) {
    .work {
      padding: 72px 20px;
    }

    .work-header {
      margin-bottom: 20px;
    }

    .work-description {
      margin-bottom: 24px;
    }

    .carousel-wrapper {
      display: flex;
      flex-direction: column;
    }

    /* Paging moves above the card. Stacked, the card ran past a phone screen
       several times over, so the arrows and the 01/02 counter sat below the
       fold: a reader had no way to learn a second chapter exists. */
    .carousel-controls {
      order: -1;
      justify-content: flex-start;
      gap: 16px;
      margin-top: 0;
      margin-bottom: 16px;
    }

    /* The 90px edge mask fades 46% of a 390px viewport, taking the card's own
       first and last words with it. It exists to soften a neighbouring card,
       and at this width no neighbour is in view. */
    .carousel-viewport {
      mask-image: none;
      -webkit-mask-image: none;
      /* Real swipe. `overflow: hidden` on the base rule keeps overflow-y
         hidden, so this adds a horizontal scroller and nothing else. */
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .carousel-viewport::-webkit-scrollbar {
      display: none;
    }

    .carousel-track {
      gap: 16px;
      /* Equal-height cards are a wide-screen concern: side by side, a short
         card next to a tall one is a ragged row. One card at a time, stretching
         the shorter chapter only injects dead air above its own CTA. */
      align-items: flex-start;
      /* The transform is desktop paging; here the scroller moves instead. */
      transition: none;
    }

    /* The 100px that used to hang under the controls. */
    .cert-subsection {
      margin-top: 64px;
    }
  }

  @media (max-width: 768px) {
    .cert-card {
      width: 230px;
      padding: 24px 18px 22px;
    }

    .cert-track {
      gap: 32px;
    }
  }
</style>
