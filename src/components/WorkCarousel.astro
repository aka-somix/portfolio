---
import WorkCard from "./WorkCard.astro"
import { works } from "../data/work"
import { certifications } from "../data/certifications"
import { sections } from "../data/sections"

const section = sections.work
---

<section class="work" id="work" data-animate="section">
  <div class="work-header">
    <h2 class="section-label">{section.title}</h2>
    <span class="section-count">0{works.length}</span>
  </div>
  <p class="section-description">{section.description}</p>

  <div class="carousel-wrapper">
    <div class="carousel-viewport" id="carousel-viewport">
      <div class="carousel-track" id="carousel-track">
        {works.map((work, i) => (
          <WorkCard
            title={work.title}
            description={work.description}
            roles={work.roles}
            slug={work.slug}
            index={i}
            total={works.length}
            image={work.image}
            imageAttribution={work.imageAttribution}
            imageAlt={work.imageAlt}
          />
        ))}
      </div>
    </div>

    <div class="carousel-controls">
      <button class="carousel-arrow" id="carousel-prev" aria-label="Previous project">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M13 4l-6 6 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <span class="carousel-indicator" id="carousel-indicator">01/{String(works.length).padStart(2, "0")}</span>
      <button class="carousel-arrow" id="carousel-next" aria-label="Next project">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M7 4l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>

  <div class="cert-subsection">
    <div class="cert-subheading">
      <span class="cert-label">Certifications</span>
      <span class="cert-count">0{certifications.length}</span>
    </div>
    <div class="cert-viewport">
      <div class="cert-track" id="cert-track">
        {certifications.map((cert) => (
          <a href={cert.link} target="_blank" rel="noopener noreferrer" class="cert-card">
            <div class="cert-logo">
              <img src={cert.logo} alt="" class="cert-logo-img" loading="lazy" />
              <div class="cert-logo-fallback">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                  <path d="M20 4l4.5 9.1 10 .9-7.3 7 1.7 10L20 27.5 11.1 31l1.7-10-7.3-7 10-.9L20 4z" fill="currentColor" opacity="0.6"/>
                  <circle cx="20" cy="19" r="6" fill="var(--bg-primary)" opacity="0.8"/>
                  <path d="M17 19l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
            <h3 class="cert-name">{cert.name}</h3>
            <span class="cert-issuer">{cert.issuer}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"
  gsap.registerPlugin(ScrollTrigger)

  const track = document.getElementById("carousel-track")
  const viewport = document.getElementById("carousel-viewport")
  const prev = document.getElementById("carousel-prev")
  const next = document.getElementById("carousel-next")
  const indicator = document.getElementById("carousel-indicator")
  const cards = track?.children

  if (track && viewport && prev && next && indicator && cards) {
    let i = 0
    const n = cards.length

    function animateCardText(card: Element) {
      const targets = [
        card.querySelector(".card-counter"),
        card.querySelector(".card-title"),
        card.querySelector(".card-description"),
        card.querySelector(".card-roles"),
      ].filter(Boolean)

      gsap.fromTo(
        targets,
        { y: 24, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.5, stagger: 0.08, ease: "power2.out", delay: 0.15 }
      )
    }

    const slide = (animateText = true) => {
      const cardW = (cards[0] as HTMLElement).offsetWidth
      track.style.transform = `translateX(${(viewport.offsetWidth - cardW) / 2 - i * cardW * 1.2}px)`
      indicator.textContent = `${String(i + 1).padStart(2, "0")}/${String(n).padStart(2, "0")}`
      if (animateText) animateCardText(cards[i])
    }

    prev.onclick = () => { i = (i - 1 + n) % n; slide() }
    next.onclick = () => { i = (i + 1) % n; slide() }

    slide(false)

    ScrollTrigger.create({
      trigger: document.querySelector(".work"),
      start: "top 75%",
      once: true,
      onEnter: () => animateCardText(cards[0]),
    })
  }

  // === Certifications auto-scroll ===
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

  const certTrack = document.getElementById("cert-track")
  if (certTrack && !reduceMotion) {
    const origCards = [...certTrack.querySelectorAll(".cert-card")]
    origCards.forEach((c) => certTrack.appendChild(c.cloneNode(true)))

    const halfW = certTrack.scrollWidth / 2
    const proxy = { x: 0 }

    const certAnim = gsap.to(proxy, {
      x: halfW,
      duration: 30,
      ease: "none",
      repeat: -1,
      paused: true,
      onUpdate: () => gsap.set(certTrack, { x: -(proxy.x % halfW) }),
    })

    origCards.forEach((card) => {
      const img = card.querySelector<HTMLImageElement>(".cert-logo-img")
      const fb = card.querySelector<HTMLElement>(".cert-logo-fallback")
      if (img && fb) {
        img.addEventListener("error", () => {
          img.style.display = "none"
          fb.style.display = "flex"
        })
      }
    })

    const workSection = document.querySelector(".work")
    if (workSection) {
      ScrollTrigger.create({
        trigger: workSection,
        start: "top bottom",
        end: "bottom top",
        onToggle: (self) => {
          self.isActive ? certAnim.resume() : certAnim.pause()
        },
      })
    }
  }
</script>

<style>
  .work {
    padding: 100px 24px;
  }

  .work-header {
    max-width: var(--max-width);
    margin: 0 auto 40px;
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .section-label {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .section-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .section-description {
    max-width: var(--max-width);
    margin: 0 auto 40px;
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .carousel-wrapper {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .carousel-viewport {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .carousel-track {
    display: flex;
    gap: 15vw;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 24px;
    margin-bottom: 100px;
  }

  .carousel-arrow {
    background: none;
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }

  .carousel-arrow:hover {
    border-color: var(--text-muted);
    color: var(--text-primary);
  }

  .carousel-indicator {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    min-width: 50px;
    text-align: center;
  }

  /* Certifications sub-section */
  .cert-subsection {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .cert-subheading {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 28px;
  }

  .cert-label {
    font-size: 0.9rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .cert-count {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
  }

  .cert-viewport {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0, #000 60px, #000 calc(100% - 60px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 60px, #000 calc(100% - 60px), transparent 100%);
  }

  .cert-track {
    display: flex;
    gap: 60px;
    padding: 4px 0;
    width: max-content;
  }

  .cert-card {
    width: 280px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 28px 24px 26px;
    background: color-mix(in srgb, var(--bg-surface) 50%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: none;
    border-radius: 12px;
    text-decoration: none;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .cert-card:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
    transform: translateY(-4px);
  }

  .cert-logo {
    width: 10rem;
    height: 10rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .cert-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cert-logo-fallback {
    display: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--text-muted);
  }

  .cert-name {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    line-height: 1.3;
    text-align: center;
  }

  .cert-issuer {
    font-size: 0.5rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-align: center;
  }

  @media (max-width: 768px) {
    .cert-card {
      width: 230px;
      padding: 24px 18px 22px;
    }

    .cert-track {
      gap: 32px;
    }
  }
</style>
