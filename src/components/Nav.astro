---
const sections = [
  { id: "services", label: "Services" },
  { id: "work", label: "Work" },
  { id: "contact", label: "Contact" },
]
---

<nav class="nav">
  <div class="nav-inner">
    <a href="#" class="nav-logo" aria-label="Home">
      <svg height="32" viewBox="0 0 236 245" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="1.5" y="196.5" width="233" height="47" fill="#F3F3F3" />
        <rect x="87.5" y="91.5" width="147" height="22" fill="#F3F3F3" />
        <rect x="173.5" y="131.5" width="61" height="47" fill="#F3F3F3" />
        <rect x="1.5" y="66.5" width="61" height="47" fill="#EEA727" />
        <rect x="1.5" y="1.5" width="229" height="47" fill="#EEA727" />
        <rect x="1.5" y="131.5" width="147" height="22" fill="#EEA727" />
      </svg>
    </a>

    <div class="nav-links">
      {sections.map((section) => (
        <a href={`#${section.id}`} class="nav-link" data-animate="nav-link">
          <span data-nav-text>{section.label}</span>
        </a>
      ))}
    </div>

    <a href="#" class="nav-cta" data-animate="cta">
      <span data-cta-label>Let's meet</span>
      <span data-cta-alt aria-hidden="true">Book now</span>
    </a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--bg-accent);
    border-bottom: 1px solid var(--border-color);
    height: var(--nav-height);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    color: var(--text-primary);
    transition: opacity 0.2s;
  }

  .nav-logo:hover {
    opacity: 0.7;
  }

  .nav-links {
    display: flex;
    gap: 32px;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .nav-link {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color 0.2s;
    overflow: hidden;
    height: 1.2em;
  }

  .nav-link span {
    display: block;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-cta {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--border-color);
    padding: 8px 12px;
    position: relative;
    transition: background 0.2s, border-color 0.2s;
  }

  .nav-cta:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  [data-cta-label] {
    display: block;
    transition: opacity 0.2s ease, transform 0.2s ease;
    opacity: 1;
    transform: translateY(0);
  }

  .nav-cta:hover [data-cta-label] {
    opacity: 0;
    transform: translateY(-6px);
  }

  [data-cta-alt] {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .nav-cta:hover [data-cta-alt] {
    opacity: 1;
    transform: translateY(0);
  }
</style>
