---
import { site, ui } from "../lib/content"

const channels = await site()
const nav = (await ui()).nav

const BOOKING_URL = channels.bookingUrl
const sections = nav.links

/**
 * The one nav link that carries a mark. A section id, not copy: the Tinyverse
 * is the only section whose subject is a drawn system, so its link is the only
 * one that gets drawn. Everything else in the row stays a word.
 */
const ORBIT_LINK = "tinyverse"
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label={nav.logoAriaLabel}>
      <svg height="32" viewBox="0 0 236 245" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="1.5" y="196.5" width="233" height="47" fill="#F3F3F3" />
        <rect x="87.5" y="91.5" width="147" height="22" fill="#F3F3F3" />
        <rect x="173.5" y="131.5" width="61" height="47" fill="#F3F3F3" />
        <rect x="1.5" y="66.5" width="61" height="47" fill="#EEA727" />
        <rect x="1.5" y="1.5" width="229" height="47" fill="#EEA727" />
        <rect x="1.5" y="131.5" width="147" height="22" fill="#EEA727" />
      </svg>
    </a>

    <div class="nav-links">
      {sections.map((section) => (
        <a href={`#${section.id}`} class="nav-link" data-animate="nav-link">
          <span class="nav-link-text"><span data-nav-text>{section.label}</span></span>
          {section.id === ORBIT_LINK && (
            <span class="nav-orbit" aria-hidden="true">
              <svg class="nav-orbit-ring" viewBox="0 0 22 14" fill="none" focusable="false">
                <ellipse cx="11" cy="7" rx="9.5" ry="4.6" stroke="currentColor" stroke-width="1" />
              </svg>
              <span class="nav-orbit-body"></span>
            </span>
          )}
        </a>
      ))}
    </div>

    <div class="nav-socials">
      <a href={channels.linkedin} target="_blank" class="nav-social" aria-label={nav.socialAriaLabels.linkedin} rel="noopener noreferrer">
        <img src="/images/social/linkedin.svg" alt="" width="20" height="20" />
      </a>
      <a href={channels.github} target="_blank" class="nav-social" aria-label={nav.socialAriaLabels.github} rel="noopener noreferrer">
        <img src="/images/social/github.svg" alt="" width="20" height="20" />
      </a>
      <a href={channels.medium} target="_blank" class="nav-social" aria-label={nav.socialAriaLabels.medium} rel="noopener noreferrer">
        <img src="/images/social/medium.svg" alt="" width="20" height="20" />
      </a>
    </div>

    <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="nav-cta" data-animate="cta">
      <span data-cta-label>{nav.cta.label}</span>
      <span data-cta-alt aria-hidden="true">{nav.cta.alt}</span>
    </a>

    <button class="nav-burger" data-burger aria-label={nav.burgerAriaLabel} aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<div class="sidebar-overlay" data-sidebar-overlay aria-hidden="true"></div>

<aside class="sidebar" data-sidebar role="dialog" aria-modal="true" aria-label={nav.sidebarAriaLabel}>
  <div class="sidebar-inner">
    <div class="sidebar-links">
      {sections.map((section) => (
        <a href={`#${section.id}`} class="sidebar-link" data-sidebar-link>
          {section.label}
        </a>
      ))}
    </div>
    <div class="sidebar-socials">
      <a href={channels.linkedin} target="_blank" class="nav-social" aria-label={nav.socialAriaLabels.linkedin} rel="noopener noreferrer">
        <img src="/images/social/linkedin.svg" alt="" width="20" height="20" />
      </a>
      <a href={channels.github} target="_blank" class="nav-social" aria-label={nav.socialAriaLabels.github} rel="noopener noreferrer">
        <img src="/images/social/github.svg" alt="" width="20" height="20" />
      </a>
      <a href={channels.medium} target="_blank" class="nav-social" aria-label={nav.socialAriaLabels.medium} rel="noopener noreferrer">
        <img src="/images/social/medium.svg" alt="" width="20" height="20" />
      </a>
    </div>
    <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="sidebar-cta" data-sidebar-cta>{nav.cta.label}</a>
  </div>
</aside>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--bg-accent);
    border-bottom: 1px solid var(--border-color);
    height: var(--nav-height);
  }

  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    color: var(--text-primary);
    transition: opacity 0.2s;
  }

  .nav-logo:hover {
    opacity: 0.7;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-left: 48px;
  }

  .nav-link {
    font-size: var(--size-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    /* Gold on this purple ground measures 3.17:1 — below the 4.5:1 floor for
       12px text. White is 6.53:1; gold moves to the hover state. */
    color: var(--text-primary);
    transition: color var(--duration-fast) var(--ease);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  /*
   * The clip that masks the hover lift. It sat on .nav-link itself, which meant
   * anything else in the link was cropped to 1.2em too, so the orbit mark was
   * cut in half and moved out of frame with the text. Same box, one level in.
   */
  .nav-link-text {
    display: block;
    overflow: hidden;
    height: 1.2em;
  }

  .nav-link span {
    display: block;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  /* ---- the Tinyverse mark ---------------------------------------------- */

  .nav-orbit {
    position: relative;
    display: block;
    width: 22px;
    height: 14px;
    /* Seen at an angle, like the system it points at. */
    transform: rotate(-14deg);
  }

  .nav-orbit-ring {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .nav-orbit-ring ellipse {
    stroke-opacity: 0.42;
    transition: stroke-opacity var(--duration-normal) var(--ease);
  }

  .nav-orbit-body {
    position: absolute;
    /* Rest position: the right of the ring, where the path also begins, so the
       fallback and the animated first frame are the same point. */
    top: 5px;
    left: 18.5px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    transition: background var(--duration-normal) var(--ease);
  }

  .nav-link:hover .nav-orbit-ring ellipse,
  .nav-link:focus-visible .nav-orbit-ring ellipse {
    stroke-opacity: 1;
  }

  .nav-link:hover .nav-orbit-body,
  .nav-link:focus-visible .nav-orbit-body {
    background: var(--accent);
  }

  @supports (offset-path: path("M 0 0 L 1 1")) {
    .nav-orbit-body {
      top: 0;
      left: 0;
      offset-path: path("M 20.5 7 A 9.5 4.6 0 1 1 1.5 7 A 9.5 4.6 0 1 1 20.5 7");
      offset-distance: 0%;
      offset-rotate: 0deg;
    }
  }

  @keyframes nav-orbit-run {
    to {
      offset-distance: 100%;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /*
     * Declared running-but-paused rather than applied on hover, so leaving the
     * link freezes the planet where it is instead of snapping it back to the
     * start. The orbit keeps its place between visits to the link.
     */
    .nav-orbit-body {
      animation: nav-orbit-run 2.6s linear infinite;
      animation-play-state: paused;
    }

    .nav-link:hover .nav-orbit-body,
    .nav-link:focus-visible .nav-orbit-body {
      animation-play-state: running;
    }
  }

  .nav-socials {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-left: auto;
    margin-right: 1.5rem;
  }

  .nav-social {
    display: flex;
    align-items: center;
    opacity: 0.6;
    transition: opacity 0.2s;
    line-height: 0;
  }

  .nav-social:hover {
    opacity: 1;
  }

  .nav-cta {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--border-color);
    padding: 8px 12px;
    position: relative;
    transition: background 0.2s, border-color 0.2s;
  }

  .nav-cta:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  [data-cta-label] {
    display: block;
    transition: opacity 0.2s ease, transform 0.2s ease;
    opacity: 1;
    transform: translateY(0);
  }

  .nav-cta:hover [data-cta-label] {
    opacity: 0;
    transform: translateY(-6px);
  }

  [data-cta-alt] {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .nav-cta:hover [data-cta-alt] {
    opacity: 1;
    transform: translateY(0);
  }

  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 220;
  }

  .nav-burger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 1px;
    transform-origin: center;
    transition: background 0.2s;
  }

  .nav-burger:hover span {
    background: var(--accent);
  }

  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.6);
    opacity: 0;
    pointer-events: none;
  }

  .sidebar {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 210;
    width: 280px;
    max-width: 80vw;
    background: var(--bg-accent);
    transform: translateX(-100%);
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: calc(var(--nav-height) + 32px) 24px 24px;
    height: 100%;
    overflow-y: auto;
  }

  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .sidebar-link {
    font-size: var(--size-base);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-primary);
    transition: color var(--duration-fast) var(--ease);
    padding: 12px 0;
    min-height: 44px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sidebar-link:hover {
    color: var(--accent);
  }

  .sidebar-socials {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .sidebar-cta {
    display: inline-flex;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 10px 20px;
    transition: background 0.2s, border-color 0.2s;
    align-self: flex-start;
  }

  .sidebar-cta:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 768px) {
    .nav-links,
    .nav-socials,
    .nav-cta {
      display: none;
    }

    .nav-burger {
      display: flex;
    }

    .sidebar-overlay {
      display: block;
    }

    .sidebar {
      display: block;
    }
  }

  @media (min-width: 769px) {
    .sidebar-overlay,
    .sidebar {
      display: none !important;
    }
  }
</style>

<script>
  import { gsap } from "gsap"

  const navLinks = document.querySelectorAll("[data-animate='nav-link']")
  navLinks.forEach((link) => {
    link.addEventListener("mouseenter", () => {
      const text = link.querySelector("[data-nav-text]")
      if (text) {
        gsap.to(text, { y: -4, duration: 0.2, ease: "power2.out" })
        gsap.to(text, { fontWeight: 700, duration: 0.2, ease: "power2.out" })
      }
    })
    link.addEventListener("mouseleave", () => {
      const text = link.querySelector("[data-nav-text]")
      if (text) {
        gsap.to(text, { y: 0, duration: 0.2, ease: "power2.out" })
        gsap.to(text, { fontWeight: 400, duration: 0.2, ease: "power2.out" })
      }
    })
  })

  const burger = document.querySelector("[data-burger]")
  const sidebar = document.querySelector("[data-sidebar]")
  const overlay = document.querySelector("[data-sidebar-overlay]")
  const sidebarLinks = document.querySelectorAll("[data-sidebar-link]")
  const sidebarCta = document.querySelector("[data-sidebar-cta]")
  const body = document.body
  let isOpen = false

  if (!burger || !sidebar || !overlay) {
    // Elements may not exist on non-index pages — bail silently
  } else {
    function openSidebar() {
      isOpen = true
      burger.setAttribute("aria-expanded", "true")
      overlay.setAttribute("aria-hidden", "false")
      body.style.overflow = "hidden"

      const sidebarItems = sidebar.querySelectorAll(
        "[data-sidebar-link], .sidebar-socials .nav-social, [data-sidebar-cta]" // content-ok: CSS selector list
      )

      gsap.set(sidebarItems, { opacity: 0, x: -16 })
      gsap.to(overlay, { opacity: 1, pointerEvents: "auto", duration: 0.3, ease: "power2.out" })
      gsap.to(sidebar, { x: "0%", duration: 0.4, ease: "power3.out" })
      gsap.to(sidebarItems, {
        opacity: 1,
        x: 0,
        duration: 0.3,
        stagger: 0.06,
        ease: "power2.out",
        delay: 0.15,
      })
    }

    function closeSidebar() {
      isOpen = false
      burger.setAttribute("aria-expanded", "false")
      overlay.setAttribute("aria-hidden", "true")
      body.style.overflow = ""

      gsap.to(sidebar, { x: "-100%", duration: 0.3, ease: "power2.in" })
      gsap.to(overlay, {
        opacity: 0,
        pointerEvents: "none",
        duration: 0.2,
        ease: "power2.out",
      })
    }

    burger.addEventListener("click", () => {
      isOpen ? closeSidebar() : openSidebar()
    })

    overlay.addEventListener("click", closeSidebar)

    sidebarLinks.forEach((link) => {
      link.addEventListener("click", closeSidebar)
    })

    if (sidebarCta) {
      sidebarCta.addEventListener("click", closeSidebar)
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) closeSidebar()
    })
  }

  const burgerBtn = document.querySelector(".nav-burger")
  if (burgerBtn) {
    const desktopItems = document.querySelectorAll(".nav-links, .nav-socials, .nav-cta") // content-ok: CSS selector list
    const mobileQuery = window.matchMedia("(max-width: 768px)")
    let transitionId = 0

    function animateToMobile() {
      const id = ++transitionId

      if (isOpen) {
        isOpen = false
        burger.setAttribute("aria-expanded", "false")
        overlay.setAttribute("aria-hidden", "true")
        body.style.overflow = ""
        gsap.set(sidebar, { clearProps: "transform" })
        gsap.set(overlay, { clearProps: "all" })
      }

      gsap.to(desktopItems, {
        opacity: 0,
        y: -4,
        duration: 0.2,
        ease: "power2.in",
        onComplete: () => {
          if (id === transitionId) gsap.set(desktopItems, { display: "none" })
        },
      })
      gsap.set(burgerBtn, { display: "flex" })
      gsap.fromTo(burgerBtn, { opacity: 0 }, { opacity: 1, duration: 0.25, ease: "power2.out" })
    }

    function animateToDesktop() {
      transitionId++

      if (isOpen) {
        isOpen = false
        burger.setAttribute("aria-expanded", "false")
        overlay.setAttribute("aria-hidden", "true")
        body.style.overflow = ""
        gsap.set(sidebar, { clearProps: "transform" })
        gsap.set(overlay, { clearProps: "all" })
      }

      gsap.set(burgerBtn, { opacity: 0, display: "none" })
      gsap.set(desktopItems, { display: "flex", opacity: 0, y: 6 })
      gsap.to(desktopItems, {
        opacity: 1,
        y: 0,
        duration: 0.3,
        stagger: 0.05,
        ease: "power2.out",
      })
    }

    mobileQuery.addEventListener("change", (e) => {
      e.matches ? animateToMobile() : animateToDesktop()
    })
  }
</script>
