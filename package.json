{
  "name": "app",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-content.mjs && astro build",
    "preview": "pnpm run build && wrangler dev",
    "astro": "astro",
    "check:content": "node scripts/check-content.mjs",
    "test:content": "node --test \"scripts/lib/*.test.mjs\"",
    "generate-types": "wrangler types",
    "deploy": "node scripts/check-content.mjs --strict && pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.0",
    "@astrojs/sitemap": "^3.3.1",
    "astro": "^6.3.1",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "wrangler": "^4.90.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
